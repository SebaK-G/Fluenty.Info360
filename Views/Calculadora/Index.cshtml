@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Calculadora de eficiencia";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")'>Cursos</a>
            <a href='@Url.Action("Index", "Calculadora")' class="activo">Calculadora</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
    </nav>
    <div class="usuario">
        <p>👤 @ViewBag.Menu.Nombre</p>
        <a class="salir" href='@Url.Action("Salir", "Home")'>Salir</a>
    </div>
</header>

<main class="pagina">

    <section class="titulo-pagina">
        <h1>Calculadora de eficiencia</h1>
        <p>Calculá la eficiencia de tus empleados completando este formulario. Averiguá lo mucho que puede mejorar tu equipo usando bien la IA.</p>
    </section>

        <!-- ===== Las 4 preguntas, en dos columnas ===== -->
        <form class="tarjeta" method="post" action='@Url.Action("Calcular", "Calculadora")' onsubmit="return validarCalculo()">
            <div class="encabezado-paso">
                <p class="numero-paso">1</p>
                <div>
                    <p class="paso-de">4 preguntas</p>
                    <h2>Tus datos</h2>
                </div>
            </div>
            <div class="grilla-2">

            <div class="campo">
                <p class="pregunta">1. ¿Qué tarea querés calcular?</p>
                <select id="tarea" name="IdTipoTarea" required onchange="elegirTarea()">
                    @foreach (TiposTarea tipo in ViewBag.Tipos)
                    {
                        <option value="@tipo.IdTipoTarea">@tipo.Nombre</option>
                    }
                </select>
                <!-- Los datos de cada tarea, para que calculadora.js los muestre al elegirla -->
                @foreach (TiposTarea tipo in ViewBag.Tipos)
                {
                    <input type="hidden" id="personas-tarea-@tipo.IdTipoTarea" value="@tipo.CantidadPersonas" />
                    <input type="hidden" id="ejemplo-tarea-@tipo.IdTipoTarea" value="@tipo.Ejemplo" />
                    <input type="hidden" id="porcentaje-tarea-@tipo.IdTipoTarea" value="@tipo.PorcentajeAhorro" />
                }
                <p class="ayuda" id="info-tarea"></p>
            </div>

            <div class="campo">
                <p class="pregunta">2. ¿Cuántas personas de tu equipo la hacen?</p>
                <input type="number" id="personas" name="Personas" min="1" max="10000" step="1" required oninput="marcarPersonasEditadas()" />
                <p class="ayuda" id="info-personas"></p>
            </div>

            <div class="campo">
                <p class="pregunta">3. ¿Cuántas horas por semana le dedica cada una?</p>
                <input type="text" inputmode="decimal" id="horas" name="HorasSemana" placeholder="Ej.: 5" required />
                <p class="ayuda">Si no sabés exacto, poné lo que te parezca: por ejemplo, 1 hora por día son 5 por semana.</p>
            </div>

            <div class="campo">
                <p class="pregunta">4. ¿Cuánto vale una hora de trabajo ($)? (opcional)</p>
                <input type="text" inputmode="decimal" id="valor" name="ValorHora" placeholder="Ej.: 8000" />
                <p class="ayuda">Lo que le cuesta a la empresa una hora de esa persona. Si lo dejás vacío, calculamos solo las horas.</p>
            </div>

            </div>

            <!-- Los errores de la validación (los de calculadora.js y los que manda el servidor) -->
            <p class="error @(ViewBag.Error == "" ? "oculto" : "")" id="error-calculadora">@ViewBag.Error</p>
            <div class="botones centrado separado">
                <input class="boton boton-redondo" type="submit" value="Realizar cálculo" />
            </div>
        </form>

        <!-- ===== El resultado ===== -->
        @if (ViewBag.Resultado != null)
        {
            <section class="tarjeta tarjeta-azul">
                <p class="subtitulo">Resultado · @ViewBag.Resultado.NombreTarea</p>
                <p class="numero-grande">@ViewBag.Resultado.HorasAhorradasMes.ToString("0.#")</p>
                <p class="negrita">horas por mes</p>
                <p>Son @ViewBag.Resultado.HorasAhorradasSemana().ToString("0.#") horas por semana, o @ViewBag.Resultado.DiasAhorradosMes().ToString("0.#") @(ViewBag.Resultado.DiasAhorradosMes() == 1 ? "jornada" : "jornadas") de trabajo por mes que el equipo puede usar en otra cosa.</p>
                @if (ViewBag.Resultado.PlataAhorradaMes > 0)
                {
                    <div class="grilla-2 separado">
                        <div class="dato"><h3>$ @ViewBag.Resultado.PlataAhorradaMes.ToString("N0")</h3><p>por mes</p></div>
                        <div class="dato"><h3>$ @ViewBag.Resultado.PlataAhorradaAnio().ToString("N0")</h3><p>por año</p></div>
                    </div>
                }
                <!-- Lo que ya se estaría ahorrando con lo que avanzó el equipo -->
                <div class="caja separado">
                    <p>Hoy, con tu equipo al @ViewBag.Avance% de sus cursos: ya estarían ahorrando unas @ViewBag.Resultado.HorasAhorradasHoy(ViewBag.Avance).ToString("0.#") horas por mes.</p>
                    <div class="barra"><div style="width: @(ViewBag.Avance)%"></div></div>
                    @if (ViewBag.Avance < 100)
                    {
                        <p>Cuanto más avancen en los cursos, más se acercan al ahorro total. <a class="volver" href='@Url.Action("Index", "Empleados")'>Ver cómo va cada uno</a></p>
                    }
                </div>
                <p class="ayuda separado">La cuenta: @ViewBag.Resultado.Personas @(ViewBag.Resultado.Personas == 1 ? "persona" : "personas") × @ViewBag.Resultado.HorasSemana.ToString("0.#") h por semana × @Calculos.SemanasPorMes semanas = horas de la tarea en el mes. La IA ahorra cerca del @ViewBag.Resultado.PorcentajeAhorro% de ese tiempo. Es una estimación: el ahorro real depende de cada tarea y de cuánto la usen.</p>
            </section>
        }
        else
        {
            <section class="tarjeta tarjeta-azul">
                <p class="numero-grande">—</p>
                <p class="negrita">horas por mes</p>
                <p>Completá los datos y tocá Realizar cálculo. El resultado queda guardado abajo para comparar distintas tareas.</p>
                <p class="ayuda separado">Tu equipo: @ViewBag.Personas @(ViewBag.Personas == 1 ? "persona" : "personas"), @ViewBag.EnCurso con curso, @ViewBag.Avance% de avance promedio.</p>
            </section>
        }

    <!-- ===== Cálculos guardados ===== -->
    @if (ViewBag.Calculos.Count > 0)
    {
        <section class="tarjeta tabla">
            <h2>Tus cálculos</h2>
            <div class="renglon ayuda">
                <p class="negrita">Tarea</p>
                <p class="negrita">Personas</p>
                <p class="negrita">Horas por semana</p>
                <p class="negrita">Ahorro por mes</p>
                <p class="negrita">Fecha</p>
                <p></p>
            </div>
            @foreach (Calculos calculo in ViewBag.Calculos)
            {
                <div id="calculo-@calculo.IdCalculo" class="renglon @(ViewBag.Resultado != null && calculo.IdCalculo == ViewBag.Resultado.IdCalculo ? "renglon-activo" : "")">
                    <a href='@Url.Action("Index", "Calculadora", new { IdCalculo = calculo.IdCalculo })'>@calculo.NombreTarea</a>
                    <p>@calculo.Personas @(calculo.Personas == 1 ? "persona" : "personas")</p>
                    <p>@calculo.HorasSemana.ToString("0.#") h por semana</p>
                    <div>
                        <p class="negrita">@calculo.HorasAhorradasMes.ToString("0.#") h</p>
                        @if (calculo.PlataAhorradaMes > 0)
                        {
                            <p class="ayuda">$ @calculo.PlataAhorradaMes.ToString("N0")</p>
                        }
                    </div>
                    <p>@calculo.Fecha.ToString("dd/MM/yyyy")</p>
                    <input class="boton boton-rojo" type="button" value="Borrar" onclick="borrarCalculo(@calculo.IdCalculo)" />
                </div>
            }
        </section>
    }
</main>

@section Scripts {
    <script src="~/js/calculadora.js" asp-append-version="true"></script>
}
