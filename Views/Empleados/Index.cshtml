@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Empleados";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")'>Cursos</a>
            <a href='@Url.Action("Index", "Calculadora")'>Calculadora</a>
            <a href='@Url.Action("Index", "Empleados")' class="activo">Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
    </nav>
    <div class="usuario">
        <p>👤 @ViewBag.Menu.Nombre</p>
        <a class="salir" href='@Url.Action("Salir", "Home")'>Salir</a>
    </div>
</header>

<main class="pagina">

    <section class="titulo-pagina">
        <p class="subtitulo">Tu gente</p>
        <h1>Empleados</h1>
        <p>Cómo va cada persona de tus rangos con su curso.</p>
    </section>

    <section class="tarjeta">
        @if (ViewBag.Equipo.Count == 0)
        {
            <p>Todavía no hay nadie en tus rangos. Compartí el link de cada rango desde Equipo.</p>
            <div class="botones">
                <a class="boton" href='@Url.Action("Index", "Equipo")'>Ir a Equipo</a>
            </div>
        }
        else
        {
            @foreach (EmpleadoCurso empleado in ViewBag.Equipo)
            {
                <div class="renglon">
                    <div>
                        <p class="negrita">@empleado.Nombre @empleado.Apellido</p>
                        <p class="ayuda">@empleado.NombreRango · @empleado.Puesto</p>
                    </div>
                    @if (empleado.EstadoCurso == "Confirmado")
                    {
                        <p class="etiqueta etiqueta-azul">@empleado.Progreso% · ⚡ @empleado.XP XP · 🔥 @empleado.Racha</p>
                        <a class="boton" href='@Url.Action("Ver", "Curso", new { IdCurso = empleado.IdCurso, IdUsuario = empleado.IdUsuario })'>Ver su camino</a>
                    }
                    else if (empleado.TieneFormulario)
                    {
                        <p class="etiqueta etiqueta-naranja">Esperando su curso</p>
                    }
                    else
                    {
                        <p class="etiqueta">Sin formulario</p>
                    }
                </div>
            }
        }
    </section>
</main>
