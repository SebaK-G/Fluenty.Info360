@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Empleados";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")'>Cursos</a>
            <a href='@Url.Action("Index", "Calculadora")'>Calculadora</a>
            <a href='@Url.Action("Index", "Empleados")' class="activo">Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
    </nav>
    <div class="usuario">
        <p>👤 @ViewBag.Menu.Nombre</p>
        <a class="salir" href='@Url.Action("Salir", "Home")'>Salir</a>
    </div>
</header>

<main class="pagina">

    <section class="tarjeta">
        <h1 class="centrado">Empleados</h1>

        @if (ViewBag.Equipo.Count == 0)
        {
            <p class="separado">Todavía no hay nadie en tus rangos. Compartí el link de cada rango desde Equipo.</p>
            <div class="botones">
                <a class="boton" href='@Url.Action("Index", "Equipo")'>Ir a Equipo</a>
            </div>
        }
        else
        {
            <!-- Buscador: site.js esconde los renglones que no coinciden con lo que se escribe -->
            <div class="barra-gris separado">
                <input type="search" id="buscar-empleado" placeholder="🔍 Buscar empleado" oninput="buscarEmpleado()" />
                <button type="button" class="boton" onclick="buscarEmpleado()">Buscar</button>
            </div>

            <div class="renglon-empleado encabezado-lista">
                <p>Empleados:</p>
                <p>Estado:</p>
                <p>Más info:</p>
            </div>

            @foreach (EmpleadoCurso empleado in ViewBag.Equipo)
            {
                <div class="renglon-empleado empleado">
                    <div>
                        <p class="nombre-empleado">@empleado.Nombre @empleado.Apellido</p>
                        <p class="ayuda">@empleado.NombreRango · @empleado.Puesto</p>
                    </div>
                    @if (empleado.EstadoCurso == "Confirmado")
                    {
                        <p class="estado estado-azul">En capacitación · @empleado.Progreso%</p>
                        <a class="boton boton-chiquito" href='@Url.Action("Ver", "Curso", new { IdCurso = empleado.IdCurso, IdUsuario = empleado.IdUsuario })'>Ver perfil</a>
                    }
                    else if (empleado.TieneFormulario)
                    {
                        <p class="estado estado-celeste">Esperando su curso</p>
                        <p class="boton boton-chiquito boton-apagado">Ver perfil</p>
                    }
                    else
                    {
                        <p class="estado estado-rojo">Sin formulario</p>
                        <p class="boton boton-chiquito boton-apagado">Ver perfil</p>
                    }
                </div>
            }
        }
    </section>
</main>
