@{
    ViewData["Title"] = "Una sola pregunta más";
}
@section Encabezado {
    <p class="ayuda">⏱ 10 segundos</p>
}

<main class="pagina pagina-angosta">

    <section class="titulo-pagina">
        <span class="subtitulo">Ya casi, @ViewBag.Nombre</span>
        <h1>Una sola pregunta más</h1>
        <p>Con esto tu primera lección te resuelve algo de verdad, en vez de ser un ejemplo genérico.</p>
    </section>

    <!-- Para quien dejó vacía (o con "nada") la pregunta de qué es lo que más tiempo le come -->
    <form class="columna" action='@Url.Action("UnaMas", "Formulario")' method="POST">
        <section class="tarjeta">
            <div class="campo">
                <label>¿Qué es lo que más tiempo te lleva en el día?</label>
                <div class="en-columna">
                    @foreach (string opcion in ViewBag.Opciones)
                    {
                        <label class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="Opcion" value="@opcion" /> @opcion</label>
                    }
                </div>
                <input type="text" name="Otra" maxlength="80" placeholder="Otra cosa (opcional)" />
            </div>
            <div class="campo">
                <label for="Detalle">Si querés, contalo en una frase <span class="opcional">(opcional)</span></label>
                <input type="text" id="Detalle" name="Detalle" maxlength="200" placeholder="Ej.: paso 30 pedidos por día de WhatsApp a la planilla" />
            </div>
        </section>

        <section class="titulo-pagina centrado">
            <input class="boton boton-grande" type="submit" value="Listo, armar mi curso" />
            <a class="volver" href='@Url.Action("Saltear", "Formulario")'>Saltear esta pregunta</a>
        </section>
    </form>
</main>
