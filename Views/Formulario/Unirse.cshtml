@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Sumate a tu equipo";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <p class="ayuda">⏱ Te lleva 2 minutos</p>
</header>

<main class="pagina pagina-angosta">

    <section class="titulo-pagina">
        <p class="subtitulo">Invitación de @ViewBag.Rango.NombreEmpresa</p>
        <h1>Sumate como @ViewBag.Rango.Nombre</h1>
        <p>No es un curso para volverte experto en IA: es para que tardes menos en lo que más te aburre de tu trabajo. Lecciones de 5 minutos, con ejemplos de lo que hacés vos.</p>

        <!-- Los 3 pasos: cada uno lleva a su parte del formulario -->
        <div class="separado">
            <a class="boton-chico" href="#paso-1">1 · Tu cuenta</a>
            <a class="boton-chico" href="#paso-2">2 · Tu trabajo</a>
            <a class="boton-chico" href="#paso-3">3 · Vos y la IA</a>
        </div>
    </section>

    @if (ViewBag.Mensaje != "")
    {
        <p class="aviso">@ViewBag.Mensaje</p>
    }

    <form class="columna" action='@Url.Action("Unirse", "Formulario")' method="POST">
        <input type="hidden" name="Codigo" value="@ViewBag.Rango.Codigo" />

        <!-- ===================== PASO 1: TU CUENTA ===================== -->
        <section class="tarjeta" id="paso-1">
            <div class="encabezado-paso">
                <p class="numero-paso">1</p>
                <div>
                    <p class="ayuda">Paso 1 de 3</p>
                    <h2>Tu cuenta</h2>
                </div>
            </div>

            <div class="grilla-2">
                <div class="campo">
                    <p class="pregunta">Nombre</p>
                    <input type="text" id="Nombre" name="Nombre" maxlength="50" required placeholder="Ej.: Martina" />
                </div>
                <div class="campo">
                    <p class="pregunta">Apellido</p>
                    <input type="text" id="Apellido" name="Apellido" maxlength="50" required placeholder="Ej.: Gómez" />
                </div>
                <div class="campo">
                    <p class="pregunta">Correo electrónico</p>
                    <input type="email" id="Email" name="Email" maxlength="100" required placeholder="Ej.: martina@mail.com" />
                </div>
                <div class="campo">
                    <p class="pregunta">DNI</p>
                    <input type="text" id="Dni" name="Dni" maxlength="10" required placeholder="Sin puntos" />
                </div>
                <div class="campo">
                    <p class="pregunta">Teléfono</p>
                    <input type="tel" id="Telefono" name="Telefono" maxlength="20" required placeholder="Ej.: 1155556666" />
                </div>
                <div class="campo">
                    <p class="pregunta">Contraseña</p>
                    <input type="password" id="Contrasena" name="Contrasena" maxlength="50" required placeholder="Creá una contraseña" />
                </div>
            </div>
        </section>

        <!-- ===================== PASO 2: TU TRABAJO ===================== -->
        <section class="tarjeta" id="paso-2">
            <div class="encabezado-paso">
                <p class="numero-paso">2</p>
                <div>
                    <p class="ayuda">Paso 2 de 3</p>
                    <h2>Tu trabajo</h2>
                    <p class="ayuda">De acá salen los ejemplos de tu curso. Casi todo es tocar opciones.</p>
                </div>
            </div>

            <div class="grilla-2">
                <div class="campo">
                    <p class="pregunta">¿Cuál es tu puesto?</p>
                    <input type="text" id="Puesto" name="Puesto" maxlength="50" required placeholder="Ej.: vendedor, administrativa, cajero" />
                </div>
                <div class="campo">
                    <p class="pregunta">¿En qué área trabajás?</p>
                    <select id="Area" name="Area" required>
                        <option value="">Elegí un área</option>
                        <option value="Administración y finanzas">Administración y finanzas</option>
                        <option value="Ventas">Ventas</option>
                        <option value="Atención al cliente">Atención al cliente</option>
                        <option value="Recursos Humanos">Recursos Humanos</option>
                        <option value="Marketing y diseño">Marketing y diseño</option>
                        <option value="Operaciones y logística">Operaciones y logística</option>
                        <option value="Sistemas y tecnología">Sistemas y tecnología</option>
                        <option value="Oficio o trabajo de campo">Oficio o trabajo de campo</option>
                        <option value="Dirección o gerencia">Dirección o gerencia</option>
                        <option value="Otra">Otra</option>
                    </select>
                </div>
            </div>

            <div class="campo">
                <p class="pregunta">¿Qué cosas te llevan más tiempo en la semana? (tocá las que hagas)</p>
                <div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Tareas" value="Responder mensajes o mails" /> Responder mensajes o mails</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Tareas" value="Armar presupuestos o cotizaciones" /> Armar presupuestos</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Tareas" value="Pasar o cargar datos a planillas" /> Pasar datos a planillas</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Tareas" value="Armar reportes o resúmenes" /> Armar reportes o resúmenes</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Tareas" value="Atender y responder dudas de clientes" /> Atender clientes</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Tareas" value="Escribir textos, avisos o publicaciones" /> Escribir textos o publicaciones</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Tareas" value="Organizar la agenda, turnos o pedidos" /> Organizar agenda, turnos o pedidos</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Tareas" value="Buscar información" /> Buscar información</div>
                </div>
                <input type="text" name="OtraTarea" maxlength="80" placeholder="Otra (opcional)" />
            </div>

            <div class="campo">
                <p class="pregunta">¿Qué es lo que más te aburre o más tiempo te come? (opcional)</p>
                <p class="ayuda">Es lo que más mejora tu curso: tu primera lección arranca resolviendo esto.</p>
                <input type="text" id="TareaConcreta" name="TareaConcreta" maxlength="500" placeholder="Ej.: pasar los pedidos de WhatsApp a una planilla, me lleva toda la mañana" />
            </div>

            <div class="campo">
                <p class="pregunta">¿Qué herramientas usás en tu trabajo? (podés elegir varias)</p>
                <div>
                    @foreach (Herramientas herramienta in ViewBag.Herramientas)
                    {
                        <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Herramientas" value="@herramienta.IdHerramienta" /> @herramienta.Nombre</div>
                    }
                </div>
            </div>

            <div class="campo">
                <p class="pregunta">¿En tu trabajo manejás datos de clientes? (nombres, teléfonos, cuentas, pedidos)</p>
                <div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="DatosClientes" value="Sí, todo el tiempo" required /> Sí, todo el tiempo</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="DatosClientes" value="A veces" /> A veces</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="DatosClientes" value="No" /> No</div>
                </div>
            </div>
        </section>

        <!-- ===================== PASO 3: VOS Y LA IA ===================== -->
        <section class="tarjeta" id="paso-3">
            <div class="encabezado-paso">
                <p class="numero-paso">3</p>
                <div>
                    <p class="ayuda">Paso 3 de 3</p>
                    <h2>Vos y la IA</h2>
                    <p class="ayuda">No hay respuestas malas: así sabemos desde dónde arrancar y cómo explicarte.</p>
                </div>
            </div>

            <div class="campo">
                <p class="pregunta">¿Usaste alguna vez una IA como ChatGPT o Gemini?</p>
                <div class="en-columna">
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="NivelIA" value="1" required /> Nunca la usé</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="NivelIA" value="2" /> La probé alguna vez</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="NivelIA" value="3" /> La uso a veces para cosas simples</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="NivelIA" value="4" /> La uso seguido en mi trabajo</div>
                </div>
            </div>

            <div class="campo">
                <p class="pregunta">¿Qué tan cómodo te sentís usando la compu y el celular?</p>
                <div class="en-columna">
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="ComodidadTecnologia" value="Me cuesta bastante, uso lo justo" required /> Me cuesta bastante, uso lo justo</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="ComodidadTecnologia" value="Me defiendo con lo básico" /> Me defiendo con lo básico</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="ComodidadTecnologia" value="Me manejo bien" /> Me manejo bien</div>
                </div>
            </div>

            <div class="campo">
                <p class="pregunta">¿Cuántos años tenés?</p>
                <div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="RangoEdad" value="Menos de 25 años" required /> Menos de 25</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="RangoEdad" value="Entre 25 y 40 años" /> 25 a 40</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="RangoEdad" value="Entre 40 y 55 años" /> 40 a 55</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="RangoEdad" value="Más de 55 años" /> Más de 55</div>
                </div>
            </div>

            <div class="campo">
                <p class="pregunta">¿Algo de la IA te preocupa? (podés elegir varias)</p>
                <div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="PreocupacionIA" value="Que me reemplace en el trabajo" /> Que me reemplace</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="PreocupacionIA" value="No entenderla" /> No entenderla</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="PreocupacionIA" value="La privacidad de los datos" /> La privacidad de los datos</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="PreocupacionIA" value="Que me dé información equivocada" /> Que se equivoque</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="PreocupacionIA" value="Que sea una pérdida de tiempo" /> Que sea una pérdida de tiempo</div>
                </div>
            </div>

            <div class="campo">
                <p class="pregunta">¿Cuánto tiempo por día podés dedicarle?</p>
                <div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="TiempoXDia" value="5" required /> 5 minutos</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="TiempoXDia" value="10" /> 10 minutos</div>
                    <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="radio" name="TiempoXDia" value="15" /> 15 minutos o más</div>
                </div>
            </div>

            <div class="campo">
                <p class="pregunta">¿Qué te gusta hacer fuera del trabajo? (opcional)</p>
                <p class="ayuda">Lo usamos para explicarte con comparaciones que te resulten familiares.</p>
                <input type="text" id="Hobbies" name="Hobbies" maxlength="200" placeholder="Ej.: cocinar, el fútbol, los videojuegos" />
            </div>
        </section>

        <p class="aviso">🔒 Tus respuestas solo las usa la IA para armar tu curso. Tu jefe no las ve: solo ve si vas avanzando.</p>

        <section class="titulo-pagina">
            <input class="boton boton-grande" type="submit" value="Unirme al equipo" />
            <p class="ayuda centrado">Al unirte, tu empresa va a poder armarte tu curso.</p>
        </section>
    </form>
</main>
