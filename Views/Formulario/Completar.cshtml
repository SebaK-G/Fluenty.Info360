```cshtml
@{
    ViewData["Title"] = "Tu formulario";
}

<link rel="stylesheet" href="~/css/completar.css" asp-append-version="true" />

<div class="pagina-completar">

    <header class="encabezado-invitar">
        <div class="logo-invitar">
            <img src="~/Imagenes/LogoAffinity.png" alt="Fluenty" />
            <span>Fluenty</span>
        </div>

        <nav class="nav-invitar">
            <a href="@Url.Action("Index", "Home")">Home</a>
            <a href="@Url.Action("Index", "Curso")">Cursos</a>
            <a href="@Url.Action("Index", "Calculadora")">Calculadora</a>
            <a href="@Url.Action("Index", "Empleado")">Empleados</a>
        </nav>
    </header>

    <main class="contenido-completar">

        <section class="titulo-completar">
            <h1>¡Hola, @ViewBag.Invitacion.Nombre!</h1>
            <p>
                Tu empresa te invitó a Fluenty como
                @ViewBag.Invitacion.Puesto.
                Contanos de tu trabajo para armarte tu curso.
            </p>
        </section>

        @if (ViewBag.Mensaje != null)
        {
            <p class="mensaje-completar">@ViewBag.Mensaje</p>
        }

        <section class="tarjeta-completar">

            <form action='@Url.Action("Completar", "Formulario")' method="POST">

                <input type="hidden" name="Codigo"
                       value="@ViewBag.Invitacion.Codigo" />

                <div class="seccion-completar">
                    <h2>Tu trabajo</h2>
                    <p class="descripcion-seccion">
                        Contanos sobre tus tareas y cómo trabajás.
                    </p>
                </div>

                <div class="campo-completar">
                    <label for="Tarea1">
                        ¿Cuál es tu primera tarea repetitiva?
                    </label>
                    <input type="text" id="Tarea1" name="Tarea1"
                           maxlength="80" placeholder="Tarea 1" required />
                </div>

                <div class="campo-completar">
                    <label for="Tarea2">
                        ¿Cuál es tu segunda tarea repetitiva?
                    </label>
                    <input type="text" id="Tarea2" name="Tarea2"
                           maxlength="80" placeholder="Tarea 2" required />
                </div>

                <div class="campo-completar">
                    <label for="Tarea3">
                        ¿Cuál es tu tercera tarea repetitiva?
                    </label>
                    <input type="text" id="Tarea3" name="Tarea3"
                           maxlength="80" placeholder="Tarea 3" required />
                </div>

                <div class="campo-completar">
                    <label for="Dificultades">
                        ¿Qué errores o dificultades te aparecen en esas tareas?
                    </label>
                    <textarea id="Dificultades" name="Dificultades"
                              rows="3" maxlength="250" required
                              placeholder="Describí los problemas que encontrás"></textarea>
                </div>

                <div class="campo-completar">
                    <label for="Objetivos">
                        ¿Qué te gustaría lograr al terminar el curso?
                    </label>
                    <textarea id="Objetivos" name="Objetivos"
                              rows="3" maxlength="250" required
                              placeholder="Contanos tus objetivos"></textarea>
                </div>

                <div class="campo-completar">
                    <label for="Herramientas">
                        ¿Qué herramientas usás? (Ej.: Gmail, Excel)
                    </label>
                    <input type="text" id="Herramientas" name="Herramientas"
                           maxlength="50" placeholder="Tus herramientas habituales"
                           required />
                </div>

                <div class="campo-completar">
                    <label for="NivelIA">¿Cuál es tu nivel con la IA?</label>
                    <select id="NivelIA" name="NivelIA">
                        <option value="1">Principiante</option>
                        <option value="2">Intermedio</option>
                        <option value="3">Avanzado</option>
                    </select>
                </div>

                <div class="campo-completar">
                    <label for="TiempoXDia">
                        ¿Cuántos minutos por día podés dedicarle al curso?
                    </label>
                    <input type="number" id="TiempoXDia" name="TiempoXDia"
                           min="1" placeholder="Ej.: 30" required />
                </div>

                <div class="seccion-completar seccion-cuenta">
                    <h2>Tu cuenta</h2>
                    <p class="descripcion-seccion">
                        Completá tus datos para crear tu cuenta.
                    </p>
                </div>

                <div class="campo-completar">
                    <label for="Dni">DNI</label>
                    <input type="text" id="Dni" name="Dni"
                           maxlength="50" placeholder="Ingresá tu DNI"
                           required />
                </div>

                <div class="campo-completar">
                    <label for="Telefono">Teléfono</label>
                    <input type="tel" id="Telefono" name="Telefono"
                           maxlength="50" placeholder="Ingresá tu teléfono"
                           required />
                </div>

                <div class="campo-completar campo-contrasena">
                    <label for="Contrasena">Contraseña</label>
                    <input type="password" id="Contrasena" name="Contrasena"
                           maxlength="50" placeholder="Creá una contraseña"
                           required />
                </div>

                <div class="acciones-completar">
                    <input type="submit" value="Enviar formulario" />
                </div>

            </form>
        </section>

    </main>
</div>