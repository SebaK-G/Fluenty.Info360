@{
    ViewData["Title"] = "Link inválido";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
</header>

<main class="pagina pagina-angosta">
    <section class="tarjeta centrado">
        <div class="medalla medalla-error">!</div>
        <h1>Este link no es válido</h1>
        <p>Puede que ya lo hayas usado o que esté mal copiado. Pedile a tu empresa un link nuevo.</p>
        <div class="botones centrado">
            <a class="boton" href='@Url.Action("Acceso", "Home")'>Ir a iniciar sesión</a>
        </div>
    </section>
</main>
