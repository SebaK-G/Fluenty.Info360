@{
    ViewData["Title"] = "¡Listo!";
}

<link rel="stylesheet" href="~/css/mensajes.css" asp-append-version="true" />

<div class="mensaje mensaje-chico">
    <h1>¡Gracias, @ViewBag.Nombre!</h1>
    <p>Tu cuenta ya está creada. Iniciá sesión con tu email y tu contraseña.</p>
    <a class="boton" href='@Url.Action("Acceso", "Home")'>Iniciar sesión</a>
</div>
