@using Fluenty.Info360.Models
@{
    ViewData["Title"] = ViewBag.Leccion.Titulo;
    // La lección ocupa toda la pantalla: sin el encabezado de la app
    ViewData["SinEncabezado"] = true;
}

<!-- Cartel de carga, arriba de todo para que quede pegado arriba de la pantalla (sticky). Mientras la IA responde -->
<div id="carga" class="fondo-carga">
    <div class="tarjeta">
        <p class="puntitos"><span></span><span class="puntito-2"></span><span class="puntito-3"></span></p>
        <p id="texto-carga">Un segundo...</p>
    </div>
</div>

<main class="pagina-leccion">

    <!-- ===== Barra de arriba: salir, progreso, XP y pedidos a la IA que quedan hoy ===== -->
    <header class="barra-leccion">
        <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Leccion.IdCurso })' title="Salir de la lección">✕</a>
        <div class="barra"><span id="relleno"></span></div>
        <span>⚡&nbsp;@ViewBag.XP</span>
        <span>🔥&nbsp;@ViewBag.Racha</span>
        <span title="Pedidos a la IA que te quedan hoy">🤖&nbsp;<span id="pedidos">@ViewBag.PedidosRestantes</span></span>
    </header>

    <span class="subtitulo">Unidad @ViewBag.Leccion.NumeroUnidad · @(ViewBag.EsExamen ? "Examen de la unidad" : "Lección " + ViewBag.Leccion.Numero)</span>
    <h1>@ViewBag.Leccion.Titulo</h1>

    @if (ViewBag.EsExamen)
    {
        <p class="aviso">🏆 Este es el examen de la unidad. Para pasar a la siguiente necesitás contestar bien a la primera al menos el 70% de las preguntas. Si no llegás, lo volvés a rendir con preguntas nuevas.</p>
    }
    @if (ViewBag.Mensaje != "")
    {
        <p class="aviso">@ViewBag.Mensaje</p>
    }

    <!-- Para leccion.js: cuántas tarjetas hay y en cuál arranca -->
    <input type="hidden" id="total-tarjetas" value="@ViewBag.Tarjetas.Count" />
    <input type="hidden" id="tarjeta-inicial" value="@ViewBag.TarjetaInicial" />

    <!-- ===== Las tarjetas: se ve una sola por vez (leccion.js le saca la clase "oculto" a la que toca) ===== -->
    @foreach (Tarjetas tarjeta in ViewBag.Tarjetas)
    {
        <section class="tarjeta oculto" id="tarjeta-@tarjeta.Orden">
            <!-- Los datos de la tarjeta que usa leccion.js -->
            <input type="hidden" id="id-tarjeta-@tarjeta.Orden" value="@tarjeta.IdTarjeta" />
            <input type="hidden" id="resuelta-@tarjeta.Orden" value="@(tarjeta.Resuelta ? "si" : "no")" />
            <input type="hidden" id="leer-@tarjeta.Orden" value="@tarjeta.TextoParaLeer" />

            @if (tarjeta.Tipo == "gancho")
            {
                <span class="etiqueta etiqueta-azul">💡 Para arrancar</span>
                <h2 id="titulo-@tarjeta.Orden">@tarjeta.Titulo</h2>
                <p class="texto-grande" id="texto-@tarjeta.Orden">@tarjeta.Texto</p>
            }
            else if (tarjeta.Tipo == "explicacion")
            {
                <span class="etiqueta etiqueta-azul">📘 La idea</span>
                <h2 id="titulo-@tarjeta.Orden">@tarjeta.Titulo</h2>
                @if (tarjeta.ParaQue != "")
                {
                    <p class="destacado">🎯 <strong>¿Para qué te sirve?</strong> @tarjeta.ParaQue</p>
                }
                <p class="texto-grande" id="texto-@tarjeta.Orden">@tarjeta.Texto</p>
                @if (tarjeta.Ejemplo != "")
                {
                    <div class="caja separado">
                        <strong>👣 Ejemplo paso a paso</strong>
                        @foreach (string paso in tarjeta.PasosEjemplo)
                        {
                            <p>@paso</p>
                        }
                    </div>
                }
            }
            else if (tarjeta.Tipo == "comparacion")
            {
                <span class="etiqueta etiqueta-azul">🧠 Pensalo así</span>
                <h2 id="titulo-@tarjeta.Orden">@tarjeta.Titulo</h2>
                <p class="destacado texto-grande" id="texto-@tarjeta.Orden">@tarjeta.Texto</p>
            }
            else if (tarjeta.Tipo == "historia")
            {
                <span class="etiqueta etiqueta-azul">📖 Una historia</span>
                <h2 id="titulo-@tarjeta.Orden">@tarjeta.Titulo</h2>
                <p class="texto-grande" id="texto-@tarjeta.Orden">@tarjeta.Texto</p>
            }
            else if (tarjeta.Tipo == "chat")
            {
                <span class="etiqueta etiqueta-azul">👀 Mirá cómo se hace</span>
                <h2 id="titulo-@tarjeta.Orden">@tarjeta.Titulo</h2>
                <p class="texto-grande" id="texto-@tarjeta.Orden">@tarjeta.Texto</p>
                <div class="grilla-2 separado">
                    <div class="caja">
                        <strong>❌ Así no</strong>
                        <p class="globo globo-vos">@tarjeta.PedidoMalo</p>
                        <p class="globo globo-ia">@tarjeta.RespuestaMala</p>
                    </div>
                    <div class="caja">
                        <strong>✅ Así sí</strong>
                        <p class="globo globo-vos">@tarjeta.PedidoBueno</p>
                        <input type="hidden" id="pedido-bueno-@tarjeta.Orden" value="@tarjeta.PedidoBueno" />
                        <button type="button" class="boton-chico separado" id="copiar-@tarjeta.Orden" onclick="copiar(@tarjeta.Orden)">📋 Copiar este pedido para usarlo</button>
                        <p class="globo globo-ia">@tarjeta.RespuestaBuena</p>
                    </div>
                </div>
            }
            else if (tarjeta.EsDePregunta)
            {
                <span class="etiqueta etiqueta-azul">@tarjeta.Etiqueta</span>
                <h2 id="titulo-@tarjeta.Orden">@tarjeta.Titulo</h2>
                <p class="texto-grande" id="texto-@tarjeta.Orden">@tarjeta.Texto</p>
                <p class="globo globo-ia @(tarjeta.Contexto == "" ? "oculto" : "")" id="contexto-@tarjeta.Orden">@tarjeta.Contexto</p>
                <div>
                    <button type="button" class="opcion" id="opcion-@tarjeta.Orden-A" onclick="responder(@tarjeta.Orden, 'A')" @(tarjeta.Resuelta ? "disabled" : "")>@tarjeta.OpcionA</button>
                    <button type="button" class="opcion" id="opcion-@tarjeta.Orden-B" onclick="responder(@tarjeta.Orden, 'B')" @(tarjeta.Resuelta ? "disabled" : "")>@tarjeta.OpcionB</button>
                    <button type="button" class="opcion @(tarjeta.OpcionC == "" ? "oculto" : "")" id="opcion-@tarjeta.Orden-C" onclick="responder(@tarjeta.Orden, 'C')" @(tarjeta.Resuelta ? "disabled" : "")>@tarjeta.OpcionC</button>
                </div>
                <div class="caja separado @(tarjeta.Resuelta ? "" : "oculto")" id="devolucion-@tarjeta.Orden">
                    <strong id="veredicto-@tarjeta.Orden">@(tarjeta.Resuelta ? "✅ Esta ya la contestaste bien." : "")</strong>
                    <p id="explicacion-@tarjeta.Orden">@(tarjeta.Resuelta ? tarjeta.Explicacion : "")</p>
                    <p class="destacado oculto" id="reexplicacion-@tarjeta.Orden"></p>
                    <button type="button" class="boton separado" id="otra-@tarjeta.Orden" onclick="otraPregunta(@tarjeta.Orden)">Probar con otra pregunta del mismo tema</button>
                </div>
            }
            else if (tarjeta.Tipo == "practica")
            {
                <span class="etiqueta etiqueta-azul">✍️ Probalo vos</span>
                <h2 id="titulo-@tarjeta.Orden">@tarjeta.Titulo</h2>
                <p class="texto-grande" id="texto-@tarjeta.Orden">@tarjeta.Texto</p>
                @if (tarjeta.Explicacion != "")
                {
                    <p class="destacado">💬 Pista: @tarjeta.Explicacion</p>
                }
                <textarea id="respuesta-@tarjeta.Orden" rows="5" maxlength="800" placeholder="Escribí acá tu pedido a la IA..." @(tarjeta.Resuelta ? "disabled" : "")></textarea>
                <button type="button" class="boton boton-verde boton-grande separado @(tarjeta.Resuelta ? "oculto" : "")" id="corregir-@tarjeta.Orden" onclick="practicar(@tarjeta.Orden)">Corregir mi respuesta</button>
                <p class="ayuda" id="intentos-@tarjeta.Orden">@(tarjeta.Intentos > 0 ? "Intentos: " + tarjeta.Intentos : "")</p>
                <div class="caja separado @(tarjeta.Resuelta ? "devolucion-aprobada" : "oculto")" id="devolucion-@tarjeta.Orden">
                    <strong id="veredicto-@tarjeta.Orden">@(tarjeta.Resuelta ? "✅ ¡Aprobado!" : "")</strong>
                    <p id="texto-devolucion-@tarjeta.Orden">@(tarjeta.Resuelta ? "Este ejercicio ya lo tenías aprobado." : "")</p>
                    <div class="oculto" id="ejemplo-@tarjeta.Orden">
                        <strong>👀 Así lo haría alguien que ya sabe (reescribilo con tus palabras):</strong>
                        <p class="globo globo-vos" id="texto-ejemplo-@tarjeta.Orden"></p>
                    </div>
                </div>
            }
            else if (tarjeta.Tipo == "cierre")
            {
                <span class="etiqueta etiqueta-azul">🚀 Mañana en el laburo</span>
                <h2 id="titulo-@tarjeta.Orden">@tarjeta.Titulo</h2>
                <p class="destacado texto-grande">@tarjeta.Texto</p>
                <form method="post" action='@Url.Action("Completar", "Leccion")' onsubmit="mostrarCarga('Calculando tu nota...')">
                    <input type="hidden" name="IdLeccion" value="@ViewBag.Leccion.IdLeccion" />
                    <input class="boton boton-verde boton-grande" type="submit" value='@(ViewBag.Leccion.Estado == "Completada" ? "Terminar (ya la habías hecho)" : (ViewBag.EsExamen ? "Entregar examen" : "Terminar lección"))' />
                </form>
            }

            <!-- Ayudas para entender: escuchar, más simple, otro ejemplo -->
            <div class="separado">
                <button type="button" class="boton-chico" onclick="escuchar(@tarjeta.Orden)">🔊 Escuchar</button>
                @if (!ViewBag.EsExamen && (tarjeta.Tipo == "gancho" || tarjeta.Tipo == "explicacion" || tarjeta.Tipo == "comparacion" || tarjeta.Tipo == "historia"))
                {
                    <button type="button" class="boton-chico" onclick="reexplicar(@tarjeta.Orden, 'simple')">🤷 Explicamelo más simple</button>
                    <button type="button" class="boton-chico" onclick="reexplicar(@tarjeta.Orden, 'ejemplo')">🔁 Dame otro ejemplo</button>
                }
            </div>
            <p class="aviso oculto" id="mensaje-@tarjeta.Orden"></p>
        </section>
    }

    <p class="titulo-pagina centrado separado" id="aviso-siguiente">Para seguir, primero resolvé esta tarjeta 🙂</p>

    <!-- ===== Botones de abajo ===== -->
    <div class="botones centrado">
        <button type="button" id="atras" class="boton boton-borde" onclick="anterior()">Atrás</button>
        <button type="button" id="siguiente" class="boton boton-verde" onclick="siguiente()">Continuar</button>
    </div>
</main>

@section Scripts {
    <script src="~/js/leccion.js" asp-append-version="true"></script>
}
