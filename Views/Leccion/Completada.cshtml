@{
    ViewData["Title"] = ViewBag.Aprobo ? (ViewBag.EsExamen ? "¡Examen aprobado!" : "¡Lección terminada!") : "Examen no aprobado";
}

<div id="carga" class="fondo-carga">
    <div class="tarjeta">
        <div class="puntitos"><div></div><div class="puntito-2"></div><div class="puntito-3"></div></div>
        <p>Preparando la próxima lección...</p>
    </div>
</div>

<main class="pagina-leccion centrado">
    @if (ViewBag.Aprobo)
    {
        <div class="medalla">@(ViewBag.EsExamen ? "🏆" : "✓")</div>
        <h1>@(ViewBag.EsExamen ? "¡Aprobaste el examen!" : "¡Lección terminada!")</h1>
    }
    else
    {
        <div class="medalla medalla-error">↻</div>
        <h1>Esta vez no llegaste</h1>
    }

    <section class="titulo-pagina">
        <p>@ViewBag.Leccion.Titulo</p>
        <!-- La nota: preguntas bien contestadas a la primera -->
        <p class="numero-grande">@ViewBag.Nota%</p>
        <p>Contestaste bien a la primera @ViewBag.AciertosPrimera de @ViewBag.Preguntas @(ViewBag.Preguntas == 1 ? "pregunta" : "preguntas").</p>
        @if (ViewBag.EsExamen)
        {
            <p>Para aprobar hace falta @ViewBag.NotaMinima%.</p>
        }
    </section>

    @if (ViewBag.Aprobo)
    {
        <div class="grilla-2 separado">
            <div class="dato"><h3>⚡ @(ViewBag.XPGanado > 0 ? "+" + ViewBag.XPGanado : "0") XP</h3><p>Ahora tenés @ViewBag.XP</p></div>
            <div class="dato"><h3>🔥 @ViewBag.Racha @(ViewBag.Racha == 1 ? "día" : "días")</h3><p>@(ViewBag.RachaSubio ? "¡Tu racha creció!" : "Racha de hoy cumplida")</p></div>
        </div>

        @if (ViewBag.XPGanado == 0)
        {
            <p class="titulo-pagina separado">Esta lección ya la habías hecho, así que no suma de nuevo. ¡Pero repasar siempre suma!</p>
        }
        else
        {
            <p class="titulo-pagina separado">El XP sale de cómo te fue: 10 por cada pregunta bien a la primera y 4 por cada una que aprendiste después de equivocarte@(ViewBag.EsExamen ? ", más 20 por aprobar el examen" : "").</p>
        }

        @if (ViewBag.Ofrecer == "saltar")
        {
            <!-- Nivelar por lo que hace: le salió perfecta la primera lección -->
            <section class="tarjeta separado">
                <p>🚀 ¡Todas bien a la primera! Se nota que esto ya lo manejás. Si querés, salteá las lecciones 2 a 4 de esta unidad y andá directo al examen. Si lo aprobás, pasás a la unidad siguiente.</p>
                <form method="post" action='@Url.Action("Saltar", "Leccion")'>
                    <input type="hidden" name="IdLeccion" value="@ViewBag.Leccion.IdLeccion" />
                    <input class="boton boton-verde separado" type="submit" value="Ir directo al examen" />
                </form>
            </section>
        }
        else if (ViewBag.Ofrecer == "bajar")
        {
            <!-- Nivelar por lo que hace: la primera lección le costó mucho -->
            <section class="tarjeta separado">
                <p>🤝 Esta lección te costó un poco. No pasa nada: capaz te conviene arrancar una unidad antes, con lo básico, y después volver acá con todo más claro.</p>
                <form method="post" action='@Url.Action("Bajar", "Leccion")'>
                    <input type="hidden" name="IdLeccion" value="@ViewBag.Leccion.IdLeccion" />
                    <input class="boton boton-verde separado" type="submit" value="Arrancar por lo básico" />
                </form>
            </section>
        }

        <div class="botones centrado">
            @if (ViewBag.Proxima != null)
            {
                <a class="boton boton-verde" href='@Url.Action("Index", "Leccion", new { IdLeccion = ViewBag.Proxima.IdLeccion })' onclick="mostrarCarga()">Seguir con: @ViewBag.Proxima.Titulo</a>
            }
            <a class="boton boton-borde" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Leccion.IdCurso })'>Volver a mi curso</a>
        </div>
        <p class="titulo-pagina separado">Consejo: hacé una lección por día para que la racha no se corte.</p>
    }
    else
    {
        <p class="titulo-pagina separado">No pasa nada: repasá las lecciones de la unidad y volvé a rendirlo. Te armamos un examen nuevo, con otras preguntas, así no se puede pasar de memoria.</p>
        <div class="botones centrado">
            <a class="boton boton-verde" href='@Url.Action("Index", "Leccion", new { IdLeccion = ViewBag.Leccion.IdLeccion })' onclick="mostrarCarga()">Volver a rendir</a>
            <a class="boton boton-borde" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Leccion.IdCurso })'>Repasar la unidad</a>
        </div>
    }
</main>
