@{
    ViewData["Title"] = "No se pudo armar la lección";
}

<main class="pagina-leccion centrado">
    <div class="medalla medalla-error">!</div>
    <h1>No pudimos armar la lección</h1>
    <p class="titulo-pagina">@ViewBag.Error</p>
    <div class="botones centrado">
        <a class="boton boton-verde" href='@Url.Action("Index", "Leccion", new { IdLeccion = ViewBag.Leccion.IdLeccion })'>Probar de nuevo</a>
        <a class="boton boton-borde" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Leccion.IdCurso })'>Volver a mi curso</a>
    </div>
</main>
