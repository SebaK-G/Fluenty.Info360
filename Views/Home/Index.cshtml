@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Home";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")' class="activo">Home</a>
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")'>Cursos</a>
            <a href='@Url.Action("Index", "Calculadora")'>Calculadora</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
    </nav>
    <div class="usuario">
        <p>👤 @ViewBag.Menu.Nombre</p>
        <a class="salir" href='@Url.Action("Salir", "Home")'>Salir</a>
    </div>
</header>

<!-- Cartel de carga, arriba de todo para que quede pegado arriba de la pantalla (sticky). Mientras la IA arma la lección (la primera vez tarda unos segundos) -->
<div id="carga" class="fondo-carga">
    <div class="tarjeta">
        <h2>Preparando tu lección</h2>
        <p>La IA está armando las explicaciones con ejemplos de tu trabajo.</p>
        <div class="barra barra-carga"><div></div></div>
    </div>
</div>

<main class="pagina">

    @if (ViewBag.Gestiona)
    {
        <!-- ===== Arriba: el saludo con los números a la izquierda y el plan (o el equipo) a la derecha ===== -->
        <div class="grilla-2">
            <div class="columna">
                <section class="tarjeta">
                    <h1>¡Hola, @ViewBag.Nombre!</h1>
                    <p>Todo lo que necesitás para capacitar, gestionar y hacer más eficiente a todo tu equipo de @ViewBag.NombreEmpresa, en un solo lugar.</p>
                </section>
                <div class="grilla-3">
                    <div class="tarjeta numero-info"><h3>ⓘ @ViewBag.CantidadPersonas</h3><p>Personas a tu cargo</p></div>
                    <div class="tarjeta numero-info"><h3>ⓘ @ViewBag.EnCapacitacion</h3><p>En capacitación</p></div>
                    <div class="tarjeta numero-info"><h3>ⓘ @ViewBag.EsperandoCurso</h3><p>Esperando su curso</p></div>
                </div>
            </div>

            <section class="tarjeta">
                <div class="fila">
                    @if (ViewBag.EsDueno)
                    {
                        <p class="negrita">☑ Tu plan</p>
                    }
                    else
                    {
                        <p class="negrita">👥 Tu equipo</p>
                    }
                    <a class="ver-todas" href='@Url.Action("Index", "Equipo")'>Ver todas →</a>
                </div>
                @if (ViewBag.EsDueno)
                {
                    <h2 class="separado">Plan Empresarial Activo</h2>
                    <p>Contás con el plan empresarial financiado por @ViewBag.MesesRestantes meses más, con @ViewBag.CantidadCursos cursos confirmados en tus rangos.</p>
                }
                else
                {
                    <h2 class="separado">@ViewBag.CantidadRangos rangos a tu cargo</h2>
                    <p>@ViewBag.CantidadCursos cursos confirmados en tus rangos.</p>
                }
                <div class="fila separado">
                    <p>En capacitación: @ViewBag.EnCapacitacion/@ViewBag.CantidadPersonas</p>
                    <p>@(ViewBag.CantidadPersonas == 0 ? 0 : ViewBag.EnCapacitacion * 100 / ViewBag.CantidadPersonas)%</p>
                </div>
                <div class="barra"><div style="width: @(ViewBag.CantidadPersonas == 0 ? 0 : ViewBag.EnCapacitacion * 100 / ViewBag.CantidadPersonas)%"></div></div>
            </section>
        </div>
    }
    else
    {
        <section class="tarjeta">
            <h1>¡Hola, @ViewBag.Nombre!</h1>
            <p class="texto-grande">Seguí aprendiendo y llevá la IA a tu trabajo de todos los días.</p>
            <p>Estás en el espacio de capacitación de @ViewBag.NombreEmpresa. Tu próximo paso te está esperando.</p>
        </section>
    }

    <!-- ===== Mis cursos (lo ve cualquiera que tenga al menos uno) ===== -->
    @if (ViewBag.MisCursos.Count > 0)
    {
        <section class="tarjeta tarjeta-azul" id="mis-cursos">
            <div class="curso-asignado">
                <div>
                    <p class="subtitulo">📚 @(ViewBag.MisCursos.Count == 1 ? "Tu curso asignado" : "Tus cursos asignados")</p>
                    @foreach (CursoInscripto curso in ViewBag.MisCursos)
                    {
                        <div class="separado">
                            <h2>@curso.Titulo</h2>
                            <div class="barra"><div style="width: @(curso.Progreso)%"></div></div>
                            <p class="negrita">@curso.Progreso% completado</p>
                            @if (curso.Proxima != null)
                            {
                                <p class="negrita">@(curso.Progreso == 0 ? "Primera lección" : "Próxima lección"): @curso.Proxima.Titulo</p>
                                <div class="botones separado">
                                    <a class="boton boton-oscuro" href='@Url.Action("Index", "Leccion", new { IdLeccion = curso.Proxima.IdLeccion })' onclick="mostrarCarga()">@(curso.Progreso == 0 ? "Empezar el curso" : "Seguir aprendiendo")</a>
                                </div>
                            }
                            else
                            {
                                <div class="botones separado">
                                    <a class="boton boton-oscuro" href='@Url.Action("Ver", "Curso", new { IdCurso = curso.IdCurso })'>Ver el curso</a>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="grilla-2">
                    <div class="dato"><p class="dato-icono">⚡</p><h3>@ViewBag.XP</h3><p>XP</p></div>
                    <div class="dato"><p class="dato-icono">🔥</p><h3>@ViewBag.Racha</h3><p>días de racha</p></div>
                </div>
            </div>
        </section>
    }
    else if (!ViewBag.Gestiona && !ViewBag.EsDueno)
    {
        <section class="tarjeta">
            <h2>Tu curso</h2>
            <p>Todavía no tenés un curso. Cuando tu responsable te lo asigne, lo vas a ver acá.</p>
        </section>
    }

    <!-- ===== Herramientas de quien no tiene rangos abajo ===== -->
    @if (!ViewBag.Gestiona)
    {
        <section class="tarjeta herramientas">
            <h2>Herramientas para tu aprendizaje</h2>
            <div class="grilla-2">
                @if (ViewBag.MisCursos.Count > 0)
                {
                    <div class="caja fila">
                        <div>
                            <h3>Mi curso</h3>
                            <p class="ayuda">Revisá las unidades y los objetivos de tu capacitación.</p>
                        </div>
                        <a class="boton" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.MisCursos[0].IdCurso })'>Ver unidades</a>
                    </div>
                }
                <div class="caja fila">
                    <div>
                        <h3>Explorar nuevos cursos</h3>
                        <p class="ayuda">Encontrá cursos que armaron otros equipos.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Buscar", "CursoPublico")'>Buscar</a>
                </div>
                <div class="caja fila">
                    <div>
                        <h3>Asistente IA</h3>
                        <p class="ayuda">Preguntale a la IA cómo usarla en tu trabajo.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Index", "Asistente")'>Preguntar</a>
                </div>
            </div>
        </section>
    }

    <!-- ===== Su gente (solo si tiene rangos abajo) ===== -->
    @if (ViewBag.Gestiona)
    {
        <section class="tarjeta herramientas">
            <h2 class="centrado">▦ Herramientas principales</h2>
            <div class="grilla-2">
                <div class="caja fila">
                    <div>
                        <h3>Crear curso con IA</h3>
                        <p>Generá cursos completos con IA adaptados al rol y puesto en segundos.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Index", "Curso")'>Generar</a>
                </div>
                <div class="caja fila">
                    <div>
                        <h3>Calcular ahorro y rendimiento</h3>
                        <p>Calculá horas ahorradas y retorno en capacitación técnica.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Index", "Calculadora")'>Calcular</a>
                </div>
                <div class="caja fila">
                    <div>
                        <h3>Explorar nuevos cursos</h3>
                        <p>Encontrá información y capacitaciones rápidamente en el catálogo.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Buscar", "CursoPublico")'>Buscar</a>
                </div>
                <div class="caja fila">
                    <div>
                        <h3>Visualizar empleados</h3>
                        <p>Seguí el progreso de tus empleados, su XP y su racha.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Index", "Empleados")'>Seguir</a>
                </div>
                <div class="caja fila">
                    <div>
                        <h3>Tu equipo y sus links</h3>
                        <p>Mirá el árbol de rangos y compartí el link de cada uno.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Index", "Equipo")'>Ver equipo</a>
                </div>
            </div>
        </section>

        @if (ViewBag.Quietos.Count > 0)
        {
            <!-- Solo se ve si participa, nunca lo que contestó en su formulario -->
            <section class="tarjeta">
                <p class="subtitulo">⏸ Para darles un empujón</p>
                <h2>@ViewBag.Quietos.Count @(ViewBag.Quietos.Count == 1 ? "persona no avanza" : "personas no avanzan")</h2>
                @foreach (string quieto in ViewBag.Quietos)
                {
                    <p class="renglon">@quieto</p>
                }
                <p class="ayuda">Un mensaje tuyo ayuda más que cualquier aviso: las lecciones son de 5 minutos y les ahorran trabajo.</p>
            </section>
        }

        <section class="tarjeta">
            <h2>Actividades recientes</h2>
            @if (ViewBag.Actividades.Count > 0)
            {
                foreach (string actividad in ViewBag.Actividades)
                {
                    <p class="renglon">@actividad</p>
                }
            }
            else
            {
                <p>Todavía no hay actividades. Cuando confirmes el curso de un rango, va a aparecer acá.</p>
            }
        </section>
    }
    else if (ViewBag.EsDueno)
    {
        <section class="tarjeta">
            <h2>Empezá armando tu equipo</h2>
            <p>Creá los rangos de tu empresa (por ejemplo Gerente, Encargado, Vendedor). Cada rango tiene su propio link para que la gente se sume.</p>
            <div class="botones">
                <a class="boton" href='@Url.Action("Index", "Equipo")'>Armar el equipo</a>
            </div>
        </section>
    }

</main>
