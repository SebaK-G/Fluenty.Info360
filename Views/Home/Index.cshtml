@{
    ViewData["Title"] = "Home";
}

<div class="home-shell">
    <header class="topbar">
        <div class="brand">Fluenty</div>
        <nav class="nav-links">
            <a href="/Home/Index">Home</a>
            <a href="#">Buscador</a>
            <a href="#">Calculadora</a>
            <a href="#">Herramientas</a>
        </nav>
        <button class="cta-btn">Abrir panel</button>
    </header>

    <main class="home-main">
        <section class="hero">
            <div class="hero-copy">
                <span class="badge">Dashboard de empresa</span>
                <h1>¡Hola, @ViewBag.Nombre!</h1>
                <p>
                    Bienvenido al panel de <strong>@ViewBag.NombreEmpresa</strong>.
                    Gestioná capacitaciones, empleados y objetivos desde un solo lugar.
                </p>
                <div class="hero-actions">
                    <a href="#" class="primary-btn">Crear curso</a>
                    <a href="#" class="secondary-btn">Ver empleados</a>
                </div>
            </div>

            <div class="hero-card">
                <p>Progreso del mes</p>
                <h2>78%</h2>
                <div class="progress-bar">
                    <span></span>
                </div>
                <small>Capacitaciones completadas</small>
            </div>
        </section>

        <section class="stats-grid">
            <div class="stat-card accent">
                <span>Cursos creados</span>
                <strong>@ViewBag.CantidadCursos</strong>
            </div>
            <div class="stat-card">
                <span>Empleados registrados</span>
                <strong>@ViewBag.CantidadEmpleados</strong>
            </div>
            <div class="stat-card">
                <span>Capacitaciones activas</span>
                <strong>09</strong>
            </div>
        </section>

        <section class="content-grid">
            <article class="panel main-panel">
                <div class="panel-header">
                    <h2>Herramientas principales</h2>
                </div>

                <div class="tool-list">
                    <div class="tool-item">
                        <h3>Crear curso con IA</h3>
                        <p>Generá capacitaciones adaptadas a tu equipo.</p>
                        <a href="#">Generar</a>
                    </div>

                    <div class="tool-item">
                        <h3>Nuevo empleado</h3>
                        <p>Registrá a un nuevo integrante de tu empresa.</p>
                        <a href="#">Crear</a>
                    </div>

                    <div class="tool-item">
                        <h3>Buscar curso</h3>
                        <p>Encontrá las capacitaciones disponibles.</p>
                        <a href="#">Buscar</a>
                    </div>
                </div>
            </article>

            <aside class="panel side-panel">
                <div class="panel-header">
                    <h2>Cursos de tu empresa</h2>
                </div>

                @if (ViewBag.Actividades != null)
                {
                    foreach (var actividad in ViewBag.Actividades)
                    {
                        <div class="activity-item">
                            <span class="dot"></span>
                            <p>@actividad</p>
                        </div>
                    }
                }
                else
                {
                    <p>Todavía no hay cursos registrados.</p>
                }
            </aside>
        </section>
    </main>
</div>
