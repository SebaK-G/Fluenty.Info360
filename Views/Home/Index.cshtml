@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/sprint2.css" asp-append-version="true" />

<div class="panel-principal">

    <header class="encabezado-app">
        <div class="logo-app">
            <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
            <span>Fluenty</span>
        </div>
        @await Html.PartialAsync("_NavApp", "Home")
    </header>

    <main class="home">

        <section class="tarjeta-home saludo">
            <h1>¡Hola, @ViewBag.Nombre!</h1>
            <p>Estás en el espacio de capacitación de @ViewBag.NombreEmpresa.</p>
        </section>

        <!-- ===== Su propio curso (lo ve cualquiera que tenga uno asignado) ===== -->
        @if (ViewBag.MiCurso != null)
        {
            <section class="tarjeta-home mi-curso">
                <div class="mi-curso-texto">
                    <p class="etiqueta-plan">📚 Tu curso</p>
                    <h2>@ViewBag.MiCurso.Titulo</h2>
                    <div class="barra-mi-curso"><span style="width: @(ViewBag.MiProgreso)%"></span></div>
                    <p class="detalle-mi-curso">@ViewBag.MiProgreso% completado</p>
                    @if (ViewBag.Proxima != null)
                    {
                        <p class="proxima">Siguiente: <strong>@ViewBag.Proxima.Titulo</strong></p>
                        <a class="boton-home grande-home" href='@Url.Action("Index", "Leccion", new { IdLeccion = ViewBag.Proxima.IdLeccion })' onclick="mostrarCarga()">Seguir aprendiendo</a>
                    }
                    else
                    {
                        <a class="boton-home grande-home" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.MiCurso.IdCurso })'>Ver mi curso</a>
                    }
                </div>
                <div class="medallas">
                    <div class="medalla">
                        <span class="icono-medalla">⚡</span>
                        <strong>@ViewBag.XP</strong>
                        <p>XP</p>
                    </div>
                    <div class="medalla">
                        <span class="icono-medalla">🔥</span>
                        <strong>@ViewBag.Racha</strong>
                        <p>días de racha</p>
                    </div>
                </div>
            </section>
        }
        else if (!ViewBag.Gestiona && !ViewBag.EsDueno)
        {
            <section class="tarjeta-home">
                <h2>Tu curso</h2>
                <p>Todavía no tenés un curso. Cuando tu responsable te lo asigne, lo vas a ver acá.</p>
            </section>
        }

        <!-- ===== Su gente (solo si tiene rangos abajo) ===== -->
        @if (ViewBag.Gestiona)
        {
            <div class="fila-superior">
                <div class="izquierda">
                    <div class="estadisticas">
                        <div class="tarjeta-home">
                            <h2>@ViewBag.CantidadPersonas</h2>
                            <p>Personas a tu cargo</p>
                        </div>
                        <div class="tarjeta-home">
                            <h2>@ViewBag.EnCapacitacion</h2>
                            <p>En capacitación</p>
                        </div>
                        <div class="tarjeta-home">
                            <h2>@ViewBag.EsperandoCurso</h2>
                            <p>Esperando su curso</p>
                        </div>
                    </div>
                </div>

                <section class="tarjeta-home plan">
                    @if (ViewBag.EsDueno)
                    {
                        <p class="etiqueta-plan">✓ Tu plan</p>
                        <h2>Plan Empresarial Activo</h2>
                        <p>Contás con el plan empresarial financiado por @ViewBag.MesesRestantes meses más.</p>
                    }
                    else
                    {
                        <p class="etiqueta-plan">👥 Tu equipo</p>
                        <h2>@ViewBag.CantidadRangos rangos a tu cargo</h2>
                    }
                    <p><strong>@ViewBag.CantidadCursos</strong> cursos confirmados en tus rangos.</p>
                </section>
            </div>

            @if (ViewBag.Quietos.Count > 0)
            {
                <!-- Solo se ve si participa, nunca lo que contestó en su formulario -->
                <section class="tarjeta-home quietos">
                    <p class="etiqueta-plan">⏸ Para darles un empujón</p>
                    <h2>@ViewBag.Quietos.Count @(ViewBag.Quietos.Count == 1 ? "persona no avanza" : "personas no avanzan")</h2>
                    <ul class="lista-quietos">
                        @foreach (string quieto in ViewBag.Quietos)
                        {
                            <li>@quieto</li>
                        }
                    </ul>
                    <p class="ayuda-quietos">Un mensaje tuyo ayuda más que cualquier aviso: las lecciones son de 5 minutos y les ahorran trabajo.</p>
                </section>
            }

            <section class="tarjeta-home herramientas">
                <h2>Herramientas principales</h2>
                <div class="grilla-herramientas">
                    <div class="herramienta">
                        <div>
                            <h3>Tu equipo y sus links</h3>
                            <p>Mirá el árbol de rangos y compartí el link de cada uno.</p>
                        </div>
                        <a class="boton-home" href='@Url.Action("Index", "Equipo")'>Ver equipo</a>
                    </div>
                    <div class="herramienta">
                        <div>
                            <h3>Crear cursos con IA</h3>
                            <p>Un curso por rango, con la IA nivelando a cada persona.</p>
                        </div>
                        <a class="boton-home" href='@Url.Action("Index", "Curso")'>Generar</a>
                    </div>
                    <div class="herramienta">
                        <div>
                            <h3>Visualizar empleados</h3>
                            <p>Seguí el progreso, el XP y la racha de cada persona.</p>
                        </div>
                        <a class="boton-home" href='@Url.Action("Index", "Empleado")'>Seguir</a>
                    </div>
                    <div class="herramienta">
                        <div>
                            <h3>Calcular ahorro y rendimiento</h3>
                            <p>Calculá horas ahorradas y retorno en capacitación.</p>
                        </div>
                        <span class="boton-home deshabilitado">Próximamente</span>
                    </div>
                </div>
            </section>

            <section class="tarjeta-home">
                <h2>Actividades recientes</h2>
                @if (ViewBag.Actividades.Count > 0)
                {
                    foreach (string actividad in ViewBag.Actividades)
                    {
                        <p class="actividad">@actividad</p>
                    }
                }
                else
                {
                    <p>Todavía no hay actividades. Cuando confirmes el curso de un rango, va a aparecer acá.</p>
                }
            </section>
        }
        else if (ViewBag.EsDueno)
        {
            <section class="tarjeta-home">
                <h2>Empezá armando tu equipo</h2>
                <p>Creá los rangos de tu empresa (por ejemplo Gerente, Encargado, Vendedor). Cada rango tiene su propio link para que la gente se sume.</p>
                <a class="boton-home grande-home" href='@Url.Action("Index", "Equipo")'>Armar el equipo</a>
            </section>
        }

    </main>
</div>

<!-- Mientras la IA arma la lección (la primera vez tarda unos segundos) -->
<div id="carga" class="fondo-carga">
    <div class="caja-carga">
        <h2>Preparando tu lección</h2>
        <p>La IA está armando las explicaciones con ejemplos de tu trabajo.</p>
        <div class="barra-carga"><span></span></div>
    </div>
</div>

<script>
    function mostrarCarga() {
        document.getElementById("carga").style.display = "flex";
    }
    window.onpageshow = function () {
        document.getElementById("carga").style.display = "none";
    };
</script>
