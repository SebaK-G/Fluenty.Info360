@{
    ViewData["Title"] = "Home Page";
}

<div class="panel-principal">

    <header class="main-header">
        <div class="brand" aria-label="Fluenty">
            <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
            <span>Fluenty</span>
        </div>

        <nav class="main-nav" aria-label="Navegación principal">
            <a href="/Home/Index" class="nav-link active">Home</a>
            <a href="#" class="nav-link">Buscador</a>
            <a href="#" class="nav-link">Calculadora</a>
            <a href="#" class="nav-link">Herramientas</a>
        </nav>
    </header>

    <main>
        <h1>¡Hola, @ViewBag.Nombre!</h1>

        <div class="plan">
            <h2>Tu empresa</h2>
            <p>Bienvenido al panel de @ViewBag.NombreEmpresa.</p>
            <p>Gestioná las capacitaciones y el equipo de tu empresa desde un solo lugar.</p>
        </div>

        <div class="estadisticas">
            <div>
                <h2>@ViewBag.CantidadCursos</h2>
                <p>Cursos creados</p>
            </div>

            <div>
                <h2>@ViewBag.CantidadEmpleados</h2>
                <p>Empleados registrados</p>
            </div>
        </div>

        <div class="secciones">

            <section>
                <h2>Herramientas principales</h2>

                <div>
                    <h3>Crear curso con IA</h3>
                    <p>Generá capacitaciones adaptadas a tu equipo.</p>
                    <a href='@Url.Action("Index", "Curso")'>Generar</a>
                </div>

                <div>
                    <h3>Nuevo empleado</h3>
                    <p>Registrá a un nuevo integrante de tu empresa.</p>
                    <a href='@Url.Action("Invitar", "Empleado")'>Crear</a>
                </div>

                <div>
                    <h3>Buscar curso</h3>
                    <p>Encontrá las capacitaciones disponibles.</p>
                    <a href="">Buscar</a>
                </div>
            </section>


            <section class="actividades">
                <h2>Plan Empresarial Activo</h2>
                <p>Contás con el plan empresarial financiado por @ViewBag.MesesRestantes meses más, con acceso simultáneo para @ViewBag.EmpleadosActivos empleados activos.</p>
            </section>


            <div class="actividades">
                <h2>Actividades recientes</h2>
                <a href="">Ver todas</a>

                @if (ViewBag.Actividades.Count > 0)
                {
                    foreach (string actividad in ViewBag.Actividades)
                    {
                        <p>@actividad</p>
                    }
                }
                else
                {
                    <p>Todavía no hay actividades recientes.</p>
                }
            </div>


            <section class="actividades">
                <h2>Cursos de tu empresa</h2>

                @if (ViewBag.CantidadCursos > 0)
                {
                    <p>Tu empresa tiene @ViewBag.CantidadCursos cursos creados.</p>
                }
                else
                {
                    <p>Todavía no hay cursos registrados.</p>
                }
            </section>

        </div>

    </main>
</div>