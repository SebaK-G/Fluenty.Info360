@{
    ViewData["Title"] = "Home Page";
}

<div class="panel-principal">

    <header>
    <nav>
		<a href="/">Fluenty</a>
	</nav>
        <a href="/Home/Index">Home</a>
        <a href="">Buscador</a>
        <a href="">Calculadora</a>
        <a href="">Herramientas</a>
    </header>

    <main>

        <h1>¡Hola, @Model.Nombre!</h1>

        <div class="plan">
            <h2>Tu empresa</h2>
            <p>Bienvenido al panel de @Model.NombreEmpresa.</p>
            <p>Gestioná las capacitaciones y el equipo de tu empresa desde un solo lugar.</p>
        </div>

        <div class="estadisticas">
            <div>
                <h2>@Model.CantidadCursos</h2>
                <p>Cursos creados</p>
            </div>

            <div>
                <h2>@Model.CantidadEmpleados</h2>
                <p>Empleados registrados</p>
            </div>
        </div>

        <div class="secciones">

            <section>
                <h2>Herramientas principales</h2>

                <div>
                    <h3>Crear curso con IA</h3>
                    <p>Generá capacitaciones adaptadas a tu equipo.</p>
                    <a href="">Generar</a>
                </div>

                <div>
                    <h3>Nuevo empleado</h3>
                    <p>Registrá a un nuevo integrante de tu empresa.</p>
                    <a href="">Crear</a>
                </div>

                <div>
                    <h3>Buscar curso</h3>
                    <p>Encontrá las capacitaciones disponibles.</p>
                    <a href="">Buscar</a>
                </div>
            </section>

            <section class="actividades">
                <h2>Cursos de tu empresa</h2>

                @if (Model.Actividades.Count > 0)
                {
                    @foreach (string actividad in Model.Actividades)
                    {
                        <div class="actividad">
                            <p>Curso: @actividad</p>
                        </div>
                    }
                }
                else
                {
                    <p>Todavía no hay cursos registrados.</p>
                }
            </section>

        </div>

    </main>
</div>
