@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Home";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")' class="activo">Home</a>
        @if (ViewBag.Menu.EsDueno || ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Equipo")'>Equipo</a>
        }
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")'>Cursos</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
        <a href='@Url.Action("Buscar", "CursoPublico")'>Explorar</a>
        <a href='@Url.Action("Index", "Asistente")'>Asistente</a>
        <a href='@Url.Action("Salir", "Home")' class="salir">Salir</a>
    </nav>
</header>

<!-- Cartel de carga, arriba de todo para que quede pegado arriba de la pantalla (sticky). Mientras la IA arma la lección (la primera vez tarda unos segundos) -->
<div id="carga" class="fondo-carga">
    <div class="tarjeta">
        <h2>Preparando tu lección</h2>
        <p>La IA está armando las explicaciones con ejemplos de tu trabajo.</p>
        <div class="barra barra-carga"><div></div></div>
    </div>
</div>

<main class="pagina">

    <section class="tarjeta">
        <h1>¡Hola, @ViewBag.Nombre!</h1>
        <p>Estás en el espacio de capacitación de @ViewBag.NombreEmpresa.</p>
    </section>

    <!-- ===== Mis cursos (lo ve cualquiera que tenga al menos uno) ===== -->
    @if (ViewBag.MisCursos.Count > 0)
    {
        <section class="tarjeta tarjeta-azul" id="mis-cursos">
            <div class="fila">
                <div>
                    <p class="subtitulo">📚 @(ViewBag.MisCursos.Count == 1 ? "Tu curso" : "Tus cursos")</p>
                    <h2>Mis cursos</h2>
                </div>
                <div class="grilla-2">
                    <div class="dato"><h3>⚡ @ViewBag.XP</h3><p>XP</p></div>
                    <div class="dato"><h3>🔥 @ViewBag.Racha</h3><p>días de racha</p></div>
                </div>
            </div>

            <div class="@(ViewBag.MisCursos.Count == 1 ? "" : "grilla-2")">
                @foreach (CursoInscripto curso in ViewBag.MisCursos)
                {
                    <div class="caja">
                        <h3>@curso.Titulo</h3>
                        <div class="barra"><div style="width: @(curso.Progreso)%"></div></div>
                        <p class="ayuda">@curso.Progreso% completado</p>
                        @if (curso.Proxima != null)
                        {
                            <p>@(curso.Progreso == 0 ? "Primera lección" : "Siguiente"): @curso.Proxima.Titulo</p>
                            <div class="botones">
                                <a class="boton boton-borde" href='@Url.Action("Index", "Leccion", new { IdLeccion = curso.Proxima.IdLeccion })' onclick="mostrarCarga()">@(curso.Progreso == 0 ? "Empezar el curso" : "Seguir aprendiendo")</a>
                            </div>
                        }
                        else
                        {
                            <div class="botones">
                                <a class="boton boton-borde" href='@Url.Action("Ver", "Curso", new { IdCurso = curso.IdCurso })'>Ver el curso</a>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
    else if (!ViewBag.Gestiona && !ViewBag.EsDueno)
    {
        <section class="tarjeta">
            <h2>Tu curso</h2>
            <p>Todavía no tenés un curso. Cuando tu responsable te lo asigne, lo vas a ver acá.</p>
        </section>
    }

    <!-- ===== Su gente (solo si tiene rangos abajo) ===== -->
    @if (ViewBag.Gestiona)
    {
        <div class="grilla-2">
            <div class="grilla-3">
                <div class="tarjeta dato"><div class="centrado"><h3>@ViewBag.CantidadPersonas</h3><p>Personas a tu cargo</p></div></div>
                <div class="tarjeta dato"><div class="centrado"><h3>@ViewBag.EnCapacitacion</h3><p>En capacitación</p></div></div>
                <div class="tarjeta dato"><div class="centrado"><h3>@ViewBag.EsperandoCurso</h3><p>Esperando su curso</p></div></div>
            </div>

            <section class="tarjeta">
                @if (ViewBag.EsDueno)
                {
                    <p class="subtitulo">✓ Tu plan</p>
                    <h2>Plan Empresarial Activo</h2>
                    <p>Contás con el plan empresarial financiado por @ViewBag.MesesRestantes meses más.</p>
                }
                else
                {
                    <p class="subtitulo">👥 Tu equipo</p>
                    <h2>@ViewBag.CantidadRangos rangos a tu cargo</h2>
                }
                <p>@ViewBag.CantidadCursos cursos confirmados en tus rangos.</p>
            </section>
        </div>

        @if (ViewBag.Quietos.Count > 0)
        {
            <!-- Solo se ve si participa, nunca lo que contestó en su formulario -->
            <section class="tarjeta">
                <p class="subtitulo">⏸ Para darles un empujón</p>
                <h2>@ViewBag.Quietos.Count @(ViewBag.Quietos.Count == 1 ? "persona no avanza" : "personas no avanzan")</h2>
                @foreach (string quieto in ViewBag.Quietos)
                {
                    <p class="renglon">@quieto</p>
                }
                <p class="ayuda">Un mensaje tuyo ayuda más que cualquier aviso: las lecciones son de 5 minutos y les ahorran trabajo.</p>
            </section>
        }

        <section class="tarjeta">
            <h2>Herramientas principales</h2>
            <div class="grilla-2">
                <div class="caja fila">
                    <div>
                        <h3>Tu equipo y sus links</h3>
                        <p class="ayuda">Mirá el árbol de rangos y compartí el link de cada uno.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Index", "Equipo")'>Ver equipo</a>
                </div>
                <div class="caja fila">
                    <div>
                        <h3>Crear cursos con IA</h3>
                        <p class="ayuda">Un curso por rango, con la IA nivelando a cada persona.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Index", "Curso")'>Generar</a>
                </div>
                <div class="caja fila">
                    <div>
                        <h3>Visualizar empleados</h3>
                        <p class="ayuda">Seguí el progreso, el XP y la racha de cada persona.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Index", "Empleados")'>Seguir</a>
                </div>
                <div class="caja fila">
                    <div>
                        <h3>Calcular ahorro y rendimiento</h3>
                        <p class="ayuda">Calculá horas ahorradas y retorno en capacitación.</p>
                    </div>
                    <a class="boton" href='@Url.Action("Index", "Calculadora")'>Calcular</a>
                </div>
            </div>
        </section>

        <section class="tarjeta">
            <h2>Actividades recientes</h2>
            @if (ViewBag.Actividades.Count > 0)
            {
                foreach (string actividad in ViewBag.Actividades)
                {
                    <p class="renglon">@actividad</p>
                }
            }
            else
            {
                <p>Todavía no hay actividades. Cuando confirmes el curso de un rango, va a aparecer acá.</p>
            }
        </section>
    }
    else if (ViewBag.EsDueno)
    {
        <section class="tarjeta">
            <h2>Empezá armando tu equipo</h2>
            <p>Creá los rangos de tu empresa (por ejemplo Gerente, Encargado, Vendedor). Cada rango tiene su propio link para que la gente se sume.</p>
            <div class="botones">
                <a class="boton" href='@Url.Action("Index", "Equipo")'>Armar el equipo</a>
            </div>
        </section>
    }

</main>
