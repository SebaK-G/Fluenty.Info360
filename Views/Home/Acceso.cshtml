@{
    ViewData["Title"] = "Acceso";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
</header>

<main class="pagina pagina-angosta">
    <!-- Una sola tarjeta blanca: a la izquierda el formulario y a la derecha el panel oscuro -->
    <section class="tarjeta acceso">

        <div class="acceso-formulario">
            <div class="centrado">
                <p class="logo-grande"><img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" /> Fluenty</p>
                <h2 class="pestana">Iniciar sesión</h2>
            </div>
            <form asp-action="Login" asp-controller="Home" method="post">
                <div class="campo">
                    <p class="pregunta">Usuario o correo electrónico</p>
                    <input type="email" id="EmailLogin" name="Email" placeholder="✉ Ingresá tu correo electrónico" required />
                </div>
                <div class="campo">
                    <p class="pregunta">Contraseña</p>
                    <input type="password" id="ContrasenaLogin" name="Contrasena" placeholder="Ingresá la contraseña" required />
                    <a class="olvide" href="mailto:contacto@fluenty.com">¿Olvidaste tu contraseña?</a>
                </div>
                <p class="error">@ViewBag.Mensaje</p>
                <input class="boton boton-grande" type="submit" value="Acceder a Fluenty" />
            </form>
        </div>

        <div class="acceso-panel">
            <p class="acceso-bienvenida">Bienvenido a Fluenty</p>
            <h2>Donde todos se pueden capacitar para usar la Inteligencia Artificial.</h2>
            <div class="columna">
                <div class="estadistica">
                    <p class="icono">☑</p>
                    <div><h3>+200</h3><p>Cursos creados</p></div>
                </div>
                <div class="estadistica">
                    <p class="icono">👤</p>
                    <div><h3>+1.234.567</h3><p>Empleados capacitados</p></div>
                </div>
                <div class="estadistica">
                    <p class="icono">📅</p>
                    <div><h3>2.314 días</h3><p>de tiempo ahorrado para las empresas</p></div>
                </div>
            </div>
        </div>

    </section>
</main>
