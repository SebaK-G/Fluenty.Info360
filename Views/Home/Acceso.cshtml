@{
    ViewData["Title"] = "Acceso";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
</header>

<main class="pagina pagina-angosta">
    <!-- Dos tarjetas: el formulario y el panel azul de bienvenida -->
    <div class="grilla-2">

        <section class="tarjeta">
            <h1>Iniciar sesión</h1>
            <p class="ayuda">Entrá con el email y la contraseña de tu cuenta.</p>
            <form class="separado" asp-action="Login" asp-controller="Home" method="post">
                <div class="campo">
                    <p class="pregunta">Email</p>
                    <input type="email" id="EmailLogin" name="Email" placeholder="Ingresá tu correo electrónico" required />
                </div>
                <div class="campo">
                    <p class="pregunta">Contraseña</p>
                    <input type="password" id="ContrasenaLogin" name="Contrasena" placeholder="Ingresá la contraseña" required />
                </div>
                <p class="error">@ViewBag.Mensaje</p>
                <input class="boton boton-grande separado" type="submit" value="Acceder a Fluenty" />
            </form>
        </section>

        <section class="tarjeta tarjeta-azul">
            <h2>Bienvenido a Fluenty</h2>
            <p>Donde todos se pueden capacitar para usar la Inteligencia Artificial.</p>
            <div class="columna separado">
                <div class="dato"><h3>+200</h3><p>Cursos creados</p></div>
                <div class="dato"><h3>+1.234.567</h3><p>Empleados capacitados</p></div>
                <div class="dato"><h3>2.314 días</h3><p>de tiempo ahorrado para las empresas</p></div>
            </div>
        </section>
    </div>
</main>
