@{
    ViewData["Title"] = "Invitar empleado";
}

<link rel="stylesheet" href="~/css/invitar.css" asp-append-version="true" />

<div class="pagina-invitar">

    <header class="encabezado-invitar">
        <div class="logo-invitar">
            <img src="~/Imagenes/LogoAffinity.png" alt="Fluenty" />
            <span>Fluenty</span>
        </div>

        <nav class="nav-invitar">
            <a href="@Url.Action("Index", "Home")">Home</a>
            <a href="@Url.Action("Index", "Curso")">Cursos</a>
            <a href="@Url.Action("Index", "Calculadora")">Calculadora</a>
            <a href="@Url.Action("Index", "Empleado")">Empleados</a>
        </nav>
    </header>

    <main class="contenido-invitar">

        <section class="titulo-invitar">
            <h1>Invitar empleado</h1>
            <p>Cargá lo básico. El empleado va a completar el resto desde su link.</p>
        </section>

        <section class="tarjeta-invitar">

            <form action='@Url.Action("Invitar", "Empleado")' method="POST">

                <div class="campo-invitar">
                    <label for="Nombre">Nombre</label>
                    <input type="text" id="Nombre" name="Nombre"
                           maxlength="50" placeholder="Ingresá el nombre"
                           required />
                </div>

                <div class="campo-invitar">
                    <label for="Apellido">Apellido</label>
                    <input type="text" id="Apellido" name="Apellido"
                           maxlength="50" placeholder="Ingresá el apellido"
                           required />
                </div>

                <div class="campo-invitar">
                    <label for="Email">Email</label>
                    <input type="email" id="Email" name="Email"
                           maxlength="50" placeholder="Ingresá el email"
                           required />
                </div>

                <div class="campo-invitar">
                    <label for="Puesto">Puesto</label>
                    <input type="text" id="Puesto" name="Puesto"
                           maxlength="50" placeholder="Ingresá el puesto"
                           required />
                </div>

                <div class="campo-invitar campo-completo">
                    <label for="InfoEmpleador">
                        ¿Qué sabés de lo que hace en su puesto?
                    </label>
                    <textarea id="InfoEmpleador" name="InfoEmpleador"
                              rows="4" maxlength="500"
                              placeholder="Describí brevemente sus tareas y responsabilidades"
                              required></textarea>
                </div>

                <div class="acciones-invitar">
                    <input type="submit" value="Generar link" />
                </div>

            </form>

            <div class="enlace-invitaciones">
                <a href='@Url.Action("Invitaciones", "Empleado")'>
                    Ver mis invitaciones
                </a>
            </div>

        </section>

    </main>
</div>
```