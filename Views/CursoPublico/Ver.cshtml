@using Fluenty.Info360.Models
@{
    ViewData["Title"] = ViewBag.Curso.Titulo;
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")'>Cursos</a>
            <a href='@Url.Action("Index", "Calculadora")'>Calculadora</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
    </nav>
    <div class="usuario">
        <p>👤 @ViewBag.Menu.Nombre</p>
        <a class="salir" href='@Url.Action("Salir", "Home")'>Salir</a>
    </div>
</header>

<main class="pagina">

    <!-- Una sola tarjeta con todo el detalle del curso -->
    <section class="tarjeta">
        <!-- Arriba: Volver a la izquierda y el título en el medio -->
        <div class="encabezado-detalle">
            <div><a class="boton boton-gris" href='@Url.Action("Buscar", "CursoPublico")'>← Volver</a></div>
            <h2>Detalles del curso</h2>
            <div></div>
        </div>

        <div class="grilla-2 separado">
            <!-- ===== Izquierda: de qué se trata ===== -->
            <div>
                <h1>@ViewBag.Curso.Titulo</h1>
                <div class="separado">
                    <p class="etiqueta etiqueta-gris">Dificultad: @ViewBag.NombreNivel</p>
                    <p class="etiqueta etiqueta-gris">Duración: @(ViewBag.Curso.DuracionHoras > 0 ? ViewBag.Curso.DuracionHoras + " Horas" : "20 lecciones")</p>
                    @if (ViewBag.Curso.Categoria != "")
                    {
                        <p class="etiqueta etiqueta-gris">@ViewBag.Curso.Categoria</p>
                    }
                </div>

                <h3 class="separado">Información detallada:</h3>
                <p>@ViewBag.Curso.Descripcion</p>

                <h3 class="separado">Objetivos de aprendizaje:</h3>
                <ul class="lista-check">
                    @foreach (string objetivo in ViewBag.Objetivos)
                    {
                        <li>@objetivo</li>
                    }
                </ul>

                @if (ViewBag.Herramientas.Count > 0)
                {
                    <div class="en-linea separado">
                        <h3>Herramientas integradas:</h3>
                        <p>@string.Join(" - ", ViewBag.Herramientas)</p>
                    </div>
                }
            </div>

            <!-- ===== Derecha: el temario en un marco gris ===== -->
            <div class="marco">
                <div class="marco-adentro">
                    @foreach (Unidades unidad in ViewBag.Unidades)
                    {
                        <div class="separado">
                            <div class="en-linea">
                                <p class="numero">@unidad.Numero</p>
                                <h3>@unidad.Titulo</h3>
                            </div>
                            <ol class="temario">
                                @foreach (Lecciones leccion in unidad.Lecciones)
                                {
                                    <li>@leccion.Titulo</li>
                                }
                            </ol>
                        </div>
                    }
                </div>
                <p class="marco-pie">Temario · 4 unidades de 5 lecciones · @ViewBag.Inscriptos @(ViewBag.Inscriptos == 1 ? "persona inscripta" : "personas inscriptas")</p>
            </div>
        </div>

        <!-- Abajo a la derecha: inscribirse -->
        <div class="fila separado">
            <div>
                @if (ViewBag.Error != "")
                {
                    <p class="error">@ViewBag.Error</p>
                }
                @if (ViewBag.YaInscripto)
                {
                    <p>✓ Ya tenés este curso.</p>
                }
                else if (ViewBag.TieneFormulario)
                {
                    <p class="ayuda">Arrancás en la unidad que va con tu experiencia con la IA, y cada lección se arma con ejemplos de tu trabajo.</p>
                }
                else
                {
                    <p class="ayuda">Para inscribirte hace falta tu formulario de empleado: la IA lo usa para armar las lecciones a tu medida.</p>
                }
            </div>
            @if (ViewBag.YaInscripto)
            {
                <a class="boton boton-redondo" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Curso.IdCurso })'>Ir al curso</a>
            }
            else if (ViewBag.TieneFormulario)
            {
                <form method="post" action='@Url.Action("Inscribirse", "CursoPublico")' onsubmit="desactivarBoton('boton-inscribirse')">
                    <input type="hidden" name="IdCurso" value="@ViewBag.Curso.IdCurso" />
                    <input class="boton boton-redondo" type="submit" id="boton-inscribirse" value="Inscribirse al curso" />
                </form>
            }
            else
            {
                <p class="boton boton-redondo boton-apagado">Inscribirse al curso</p>
            }
        </div>
    </section>
</main>
