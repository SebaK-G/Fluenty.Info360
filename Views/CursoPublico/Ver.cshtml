@using Fluenty.Info360.Models
@{
    ViewData["Title"] = ViewBag.Curso.Titulo;
    ViewData["Activo"] = "Explorar";
}

<main class="pagina">

    <a class="volver" href='@Url.Action("Buscar", "CursoPublico")'>← Volver a los cursos</a>

    <div class="grilla-2-1">
        <!-- ===== Izquierda: de qué se trata y el temario ===== -->
        <div class="columna">
            <section class="tarjeta">
                <span class="etiqueta azul">🌎 @(ViewBag.Curso.Categoria != "" ? ViewBag.Curso.Categoria : "Curso público")</span>
                <span class="etiqueta">@ViewBag.NombreNivel</span>
                <h1 class="separado">@ViewBag.Curso.Titulo</h1>
                <p>@ViewBag.Curso.Descripcion</p>

                <h3 class="separado">Lo que vas a lograr</h3>
                <p>@ViewBag.Curso.Objetivos</p>

                @if (ViewBag.Herramientas.Count > 0)
                {
                    <h3 class="separado">Herramientas que vas a usar</h3>
                    @foreach (string herramienta in ViewBag.Herramientas)
                    {
                        <span class="etiqueta">@herramienta</span>
                    }
                }
            </section>

            <section class="tarjeta">
                <h2>Temario</h2>
                <p class="ayuda">4 unidades de 5 lecciones. La última de cada unidad es un examen.</p>
                <!-- <details> se abre y se cierra solo, sin JavaScript -->
                @foreach (Unidades unidad in ViewBag.Unidades)
                {
                    <details class="temario" open="@(unidad.Numero == 1)">
                        <summary>
                            <span class="numero">@unidad.Numero</span>
                            <span>
                                <strong>@unidad.Titulo</strong>
                                <p class="ayuda">@unidad.Objetivo</p>
                            </span>
                        </summary>
                        <ol>
                            @foreach (Lecciones leccion in unidad.Lecciones)
                            {
                                <li>@leccion.Titulo</li>
                            }
                        </ol>
                    </details>
                }
            </section>
        </div>

        <!-- ===== Derecha: inscribirse ===== -->
        <aside class="tarjeta fija">
            <div class="grilla-3">
                <div class="dato"><strong>@(ViewBag.Curso.DuracionHoras > 0 ? ViewBag.Curso.DuracionHoras + " h" : "—")</strong><span>duración</span></div>
                <div class="dato"><strong>20</strong><span>lecciones</span></div>
                <div class="dato"><strong>@ViewBag.Inscriptos</strong><span>@(ViewBag.Inscriptos == 1 ? "persona" : "personas")</span></div>
            </div>
            @if (ViewBag.Error != "")
            {
                <p class="error separado">@ViewBag.Error</p>
            }
            @if (ViewBag.YaInscripto)
            {
                <p class="separado">✓ Ya tenés este curso.</p>
                <a class="boton boton-grande separado" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Curso.IdCurso })'>Ir al curso</a>
            }
            else if (ViewBag.TieneFormulario)
            {
                <p class="separado">Arrancás en la unidad que va con tu experiencia con la IA, y cada lección se arma con ejemplos de tu trabajo.</p>
                <form method="post" action='@Url.Action("Inscribirse", "CursoPublico")' onsubmit="desactivarBoton('boton-inscribirse')">
                    <input type="hidden" name="IdCurso" value="@ViewBag.Curso.IdCurso" />
                    <input class="boton boton-grande separado" type="submit" id="boton-inscribirse" value="Inscribirme gratis" />
                </form>
            }
            else
            {
                <p class="ayuda separado">Para inscribirte hace falta tu formulario de empleado: la IA lo usa para armar las lecciones a tu medida.</p>
                <span class="boton boton-grande boton-apagado separado">Inscribirme</span>
            }
        </aside>
    </div>
</main>
