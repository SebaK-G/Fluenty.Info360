@using Fluenty.Info360.Models
@{
    ViewData["Title"] = ViewBag.Curso.Titulo;
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.EsDueno || ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Equipo")'>Equipo</a>
        }
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")'>Cursos</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
        <a href='@Url.Action("Buscar", "CursoPublico")' class="activo">Explorar</a>
        <a href='@Url.Action("Index", "Asistente")'>Asistente</a>
        <a href='@Url.Action("Salir", "Home")' class="salir">Salir</a>
    </nav>
</header>

<main class="pagina">

    <a class="volver" href='@Url.Action("Buscar", "CursoPublico")'>← Volver a los cursos</a>

    <div class="grilla-2-1">
        <!-- ===== Izquierda: de qué se trata y el temario ===== -->
        <div class="columna">
            <section class="tarjeta">
                <p class="etiqueta etiqueta-azul">🌎 @(ViewBag.Curso.Categoria != "" ? ViewBag.Curso.Categoria : "Curso público")</p>
                <p class="etiqueta">@ViewBag.NombreNivel</p>
                <h1 class="separado">@ViewBag.Curso.Titulo</h1>
                <p>@ViewBag.Curso.Descripcion</p>

                <h3 class="separado">Lo que vas a lograr</h3>
                <p>@ViewBag.Curso.Objetivos</p>

                @if (ViewBag.Herramientas.Count > 0)
                {
                    <h3 class="separado">Herramientas que vas a usar</h3>
                    @foreach (string herramienta in ViewBag.Herramientas)
                    {
                        <p class="etiqueta">@herramienta</p>
                    }
                }
            </section>

            <section class="tarjeta">
                <h2>Temario</h2>
                <p class="ayuda">4 unidades de 5 lecciones. La última de cada unidad es un examen.</p>
                @foreach (Unidades unidad in ViewBag.Unidades)
                {
                    <div class="caja separado">
                        <div class="en-linea">
                            <p class="numero">@unidad.Numero</p>
                            <h3>@unidad.Titulo</h3>
                        </div>
                        <p class="ayuda">@unidad.Objetivo</p>
                        <ol class="temario separado">
                            @foreach (Lecciones leccion in unidad.Lecciones)
                            {
                                <li>@leccion.Titulo</li>
                            }
                        </ol>
                    </div>
                }
            </section>
        </div>

        <!-- ===== Derecha: inscribirse ===== -->
        <section class="tarjeta fija">
            <div class="grilla-3">
                <div class="dato"><h3>@(ViewBag.Curso.DuracionHoras > 0 ? ViewBag.Curso.DuracionHoras + " h" : "—")</h3><p>duración</p></div>
                <div class="dato"><h3>20</h3><p>lecciones</p></div>
                <div class="dato"><h3>@ViewBag.Inscriptos</h3><p>@(ViewBag.Inscriptos == 1 ? "persona" : "personas")</p></div>
            </div>
            @if (ViewBag.Error != "")
            {
                <p class="error separado">@ViewBag.Error</p>
            }
            @if (ViewBag.YaInscripto)
            {
                <p class="separado">✓ Ya tenés este curso.</p>
                <a class="boton boton-grande separado" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Curso.IdCurso })'>Ir al curso</a>
            }
            else if (ViewBag.TieneFormulario)
            {
                <p class="separado">Arrancás en la unidad que va con tu experiencia con la IA, y cada lección se arma con ejemplos de tu trabajo.</p>
                <form method="post" action='@Url.Action("Inscribirse", "CursoPublico")' onsubmit="desactivarBoton('boton-inscribirse')">
                    <input type="hidden" name="IdCurso" value="@ViewBag.Curso.IdCurso" />
                    <input class="boton boton-grande separado" type="submit" id="boton-inscribirse" value="Inscribirme gratis" />
                </form>
            }
            else
            {
                <p class="ayuda separado">Para inscribirte hace falta tu formulario de empleado: la IA lo usa para armar las lecciones a tu medida.</p>
                <p class="boton boton-grande boton-apagado separado">Inscribirme</p>
            }
        </section>
    </div>
</main>
