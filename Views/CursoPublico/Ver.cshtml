@using Fluenty.Info360.Models
@{
    ViewData["Title"] = ViewBag.Curso.Titulo;
    List<Lecciones> lecciones = ViewBag.Lecciones;
}

<link rel="stylesheet" href="~/css/curso.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/sprint2.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/explorar.css" asp-append-version="true" />

<div class="pagina-curso">

    <header class="encabezado-app">
        <div class="logo-app">
            <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
            <span>Fluenty</span>
        </div>
        @await Html.PartialAsync("_NavApp", "Explorar")
    </header>

    <main class="contenido-curso">

        <a class="volver-buscador" href='@Url.Action("Buscar", "CursoPublico")'>← Volver a los cursos</a>

        <div class="detalle-publico">

            <!-- ===== Izquierda: de qué se trata y el temario ===== -->
            <div class="columna-detalle">
                <div class="tarjeta-curso">
                    <div class="etiquetas-publico">
                        <span class="etiqueta-categoria">🌎 @(ViewBag.Curso.Categoria != "" ? ViewBag.Curso.Categoria : "Curso público")</span>
                        <span class="etiqueta-nivel">@CursoPublico.NombreNivel(ViewBag.Curso.Nivel)</span>
                    </div>
                    <h1 class="titulo-curso">@ViewBag.Curso.Titulo</h1>
                    <p>@ViewBag.Curso.Descripcion</p>

                    <h3>Lo que vas a lograr</h3>
                    <p class="objetivos">@ViewBag.Curso.Objetivos</p>

                    @if (ViewBag.Herramientas.Count > 0)
                    {
                        <h3>Herramientas que vas a usar</h3>
                        <div class="chips-herramientas">
                            @foreach (string herramienta in ViewBag.Herramientas)
                            {
                                <span class="chip-herramienta">@herramienta</span>
                            }
                        </div>
                    }
                </div>

                <div class="tarjeta-curso">
                    <h3>Temario</h3>
                    <p class="ayuda-sprint2">4 unidades de 5 lecciones. La última de cada unidad es un examen.</p>
                    @foreach (Unidades unidad in ViewBag.Unidades)
                    {
                        <details class="unidad-temario" open="@(unidad.Numero == 1)">
                            <summary>
                                <span class="numero-temario">@unidad.Numero</span>
                                <span>
                                    <strong>@unidad.Titulo</strong>
                                    <small>@unidad.Objetivo</small>
                                </span>
                            </summary>
                            <ol class="lecciones-temario">
                                @foreach (Lecciones leccion in lecciones)
                                {
                                    if (leccion.NumeroUnidad == unidad.Numero)
                                    {
                                        <li>@leccion.Titulo</li>
                                    }
                                }
                            </ol>
                        </details>
                    }
                </div>
            </div>

            <!-- ===== Derecha: inscribirse ===== -->
            <aside class="tarjeta-curso caja-inscribirse">
                <div class="datos-curso">
                    <div><strong>@(ViewBag.Curso.DuracionHoras > 0 ? ViewBag.Curso.DuracionHoras + " h" : "—")</strong><span>duración</span></div>
                    <div><strong>20</strong><span>lecciones</span></div>
                    <div><strong>@ViewBag.Inscriptos</strong><span>@(ViewBag.Inscriptos == 1 ? "persona" : "personas")</span></div>
                </div>

                @if (ViewBag.YaInscripto)
                {
                    <p class="texto-inscribirse">✓ Ya tenés este curso.</p>
                    <a class="boton-home grande-home" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Curso.IdCurso })'>Ir al curso</a>
                }
                else if (ViewBag.TieneFormulario)
                {
                    <p class="texto-inscribirse">Arrancás en la unidad que va con tu experiencia con la IA, y cada lección se arma con ejemplos de tu trabajo.</p>
                    <form method="post" action='@Url.Action("Inscribirse", "CursoPublico")' onsubmit="this.querySelector('input[type=submit]').disabled = true;">
                        <input type="hidden" name="IdCurso" value="@ViewBag.Curso.IdCurso" />
                        <input class="boton-home grande-home" type="submit" value="Inscribirme gratis" />
                    </form>
                }
                else
                {
                    <p class="texto-inscribirse">Para inscribirte hace falta tu formulario de empleado: la IA lo usa para armar las lecciones a tu medida.</p>
                    <span class="boton-home deshabilitado">Inscribirme</span>
                }
            </aside>

        </div>
    </main>
</div>
