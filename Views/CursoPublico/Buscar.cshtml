@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Explorar cursos";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")'>Cursos</a>
            <a href='@Url.Action("Index", "Calculadora")'>Calculadora</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
    </nav>
    <div class="usuario">
        <p>👤 @ViewBag.Menu.Nombre</p>
        <a class="salir" href='@Url.Action("Salir", "Home")'>Salir</a>
    </div>
</header>

<main class="pagina">

    <section class="titulo-pagina centrado">
        <h1>Buscador</h1>
        <p>Encontrá cursos que armaron otros equipos y dejaron abiertos para todos. Al inscribirte, la IA arma cada lección con ejemplos de tu trabajo.</p>
    </section>

    <!-- ===== Buscador: una sola barra con el texto, los filtros y los botones ===== -->
    <form method="get" action='@Url.Action("Buscar", "CursoPublico")'>
        <div class="barra-busqueda">
            <input type="search" id="Texto" name="Texto" value="@ViewBag.Texto" placeholder="🔍 Buscar cursos, habilidades o herramientas IA..." />
            <select id="Nivel" name="Nivel">
                <option value="0">Todos los niveles</option>
                <option value="1" selected="@(ViewBag.Nivel == 1)">Principiante</option>
                <option value="3" selected="@(ViewBag.Nivel == 3)">Intermedio</option>
                <option value="4" selected="@(ViewBag.Nivel == 4)">Avanzado</option>
            </select>
            <select id="Orden" name="Orden">
                <option value="recientes">Más nuevos</option>
                <option value="populares" selected="@(ViewBag.Orden == "populares")">Más elegidos</option>
            </select>
            <input type="hidden" name="Categoria" value="@ViewBag.Categoria" />
            <input class="boton" type="submit" value="Buscar" />
            <a class="boton" href='@Url.Action("Index", "Asistente")'>Asistente IA</a>
        </div>
        <!-- Categorías: cada botón vuelve a buscar con esa categoría -->
        <div class="filtros separado">
            <a class="boton-chico @(ViewBag.Categoria == "" ? "boton-chico-activo" : "")" href='@Url.Action("Buscar", "CursoPublico", new { Texto = ViewBag.Texto, Nivel = ViewBag.Nivel, Orden = ViewBag.Orden })'>Todos</a>
            @foreach (string categoria in ViewBag.Categorias)
            {
                <a class="boton-chico @(ViewBag.Categoria == categoria ? "boton-chico-activo" : "")" href='@Url.Action("Buscar", "CursoPublico", new { Texto = ViewBag.Texto, Categoria = categoria, Nivel = ViewBag.Nivel, Orden = ViewBag.Orden })'>@categoria</a>
            }
        </div>
    </form>

    <!-- ===== Resultados ===== -->
    <div class="titulo-pagina">
        <h2>Resultados</h2>
        <p>@ViewBag.Cursos.Count @(ViewBag.Cursos.Count == 1 ? "curso encontrado" : "cursos encontrados")</p>
    </div>

    @if (ViewBag.Cursos.Count == 0)
    {
        <section class="tarjeta centrado">
            <h3>No encontramos cursos con esa búsqueda</h3>
            <p>Probá con otra palabra o sacá los filtros.</p>
            <div class="botones centrado">
                <a class="boton" href='@Url.Action("Buscar", "CursoPublico")'>Ver todos los cursos</a>
            </div>
        </section>
    }
    else
    {
        <div class="grilla-3">
            @foreach (CursoPublico curso in ViewBag.Cursos)
            {
                <a class="tarjeta tarjeta-curso" href='@Url.Action("Ver", "CursoPublico", new { IdCurso = curso.IdCurso })'>
                    <p class="icono-curso">🤖</p>
                    <h3>@curso.Titulo</h3>
                    <p>@curso.DescripcionCorta</p>
                    <div class="fila-siempre separado">
                        <div>
                            <p class="etiqueta etiqueta-gris">@curso.NombreNivel</p>
                            <p class="etiqueta etiqueta-gris">@(curso.DuracionHoras > 0 ? curso.DuracionHoras + " Horas" : "20 lecciones")</p>
                        </div>
                        <p class="boton boton-acceder">@(curso.YaLoTiene ? "✓ Ya lo tenés" : "Acceder")</p>
                    </div>
                </a>
            }
        </div>
    }
</main>
