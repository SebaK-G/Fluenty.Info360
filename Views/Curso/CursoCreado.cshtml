@{
    ViewData["Title"] = "Curso creado";
    ViewData["Activo"] = "Cursos";
}

<main class="pagina pagina-angosta">
    <section class="tarjeta centrado">
        <div class="medalla">✓</div>
        <p>Ya podés ver el seguimiento de tus empleados</p>
        <h1>El curso fue creado sin problemas</h1>
        <h3>"@ViewBag.Titulo"</h3>
        <div class="botones centrado">
            <a class="boton boton-borde" href='@Url.Action("Index", "Home")'>Volver</a>
            <a class="boton" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.IdCurso })'>Ver curso</a>
            <a class="boton" href='@Url.Action("Index", "Empleados")'>Ver empleados</a>
        </div>
    </section>
</main>
