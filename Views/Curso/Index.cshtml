@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Cursos";
}

<link rel="stylesheet" href="~/css/curso.css" asp-append-version="true" />

<div class="pagina-curso">

    <header class="encabezado-app">
        <div class="logo-app">
            <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
            <span>Fluenty</span>
        </div>
        <nav class="nav-app">
            <a href='@Url.Action("Index", "Home")'>Home</a>
            <a href='@Url.Action("Index", "Curso")' class="activo">Cursos</a>
            <a class="sin-link">Calculadora</a>
            <a href='@Url.Action("Index", "Empleado")'>Empleados</a>
            <a href='@Url.Action("Salir", "Home")' class="salir">Salir</a>
        </nav>
    </header>

    <main class="contenido-curso">

        <!-- Compartir el link para que los empleados se unan solos -->
        <div class="tarjeta-curso titulo-pantalla">
            <h1>Sumá a tu equipo</h1>
            <p>Compartí este link con tus empleados. Cada uno se registra y completa su formulario; después le generás el curso desde acá.</p>
            <input class="link-empresa" type="text" value="@ViewBag.Link" readonly />
            <div class="botones">
                <a class="boton-curso grande" href="https://wa.me/?text=Sumate%20a%20nuestro%20equipo%20en%20Fluenty%20y%20complet%C3%A1%20tu%20formulario:%20@(ViewBag.Link)">Compartir por WhatsApp</a>
            </div>
        </div>

        @if (ViewBag.Mensaje != null)
        {
            <p class="aviso">@ViewBag.Mensaje</p>
        }

        <div class="tarjeta-curso">
            <h2 class="centrado-texto">Empleados que completaron el formulario</h2>

            @if (ViewBag.Solicitudes.Count == 0)
            {
                <p class="centrado-texto">Todavía no se sumó nadie. Cuando un empleado complete el formulario del link, va a aparecer acá.</p>
            }
            else
            {
                @foreach (EmpleadoCurso empleado in ViewBag.Solicitudes)
                {
                    <div class="fila-empleado">
                        <div>
                            <p class="nombre-empleado">@empleado.Nombre @empleado.Apellido</p>
                            <p class="puesto"><strong>@empleado.Puesto</strong> · Tareas: @empleado.Tareas</p>
                        </div>

                        @if (empleado.IdCurso != null)
                        {
                            <a class="boton-curso" href='@Url.Action("Ver", "Curso", new { IdCurso = empleado.IdCurso })'>Revisar curso</a>
                        }
                        else
                        {
                            <form method="post" action='@Url.Action("Generar", "Curso")' onsubmit="mostrarCarga()">
                                <input type="hidden" name="IdUsuario" value="@empleado.IdUsuario" />
                                <input class="boton-curso" type="submit" value="Generar curso" />
                            </form>
                        }
                    </div>
                }
            }
        </div>
    </main>
</div>

<!-- Pantalla "Carga de datos" del Figma: se muestra mientras la IA arma el curso -->
<div id="carga" class="fondo-carga">
    <div class="tarjeta-curso caja-carga">
        <h2>Cargando datos a los cursos IA</h2>
        <p>Procesando información</p>
        <div class="barra"><div class="barra-relleno animada"></div></div>
        <p>Nuestra IA está utilizando los datos ingresados para armar el curso. Puede tardar unos segundos.</p>
    </div>
</div>

<script>
    function mostrarCarga() {
        document.getElementById("carga").style.display = "flex";
    }

    // Si el empleador vuelve para atrás, el cartel de carga se cierra
    window.onpageshow = function () {
        document.getElementById("carga").style.display = "none";
    };
</script>
