@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Cursos";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.EsDueno || ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Equipo")'>Equipo</a>
        }
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")' class="activo">Cursos</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
        <a href='@Url.Action("Buscar", "CursoPublico")'>Explorar</a>
        <a href='@Url.Action("Index", "Asistente")'>Asistente</a>
        <a href='@Url.Action("Salir", "Home")' class="salir">Salir</a>
    </nav>
</header>

<!-- Cartel de carga, arriba de todo para que quede pegado arriba de la pantalla (sticky). Mientras la IA arma el curso -->
<div id="carga" class="fondo-carga">
    <div class="tarjeta">
        <h2>Armando el curso del rango</h2>
        <div class="barra barra-carga"><div></div></div>
        <p>La IA está leyendo lo que contó cada persona para armar el curso y nivelar a cada uno. Puede tardar unos segundos.</p>
    </div>
</div>

<main class="pagina">

    <section class="titulo-pagina">
        <p class="subtitulo">Cursos por rango</p>
        <h1>Un curso para cada rango</h1>
        <p>La IA arma un curso para todo el rango con lo que contó cada persona, y nivela a cada uno: cada persona arranca en la unidad que le corresponde.</p>
    </section>

    @if (ViewBag.Mensaje != "")
    {
        <p class="aviso">@ViewBag.Mensaje</p>
    }

    @foreach (GrupoRango grupo in ViewBag.Grupos)
    {
        <section class="tarjeta">
            <div class="fila">
                <div>
                    <h2>@grupo.Rango.Nombre</h2>
                    <p class="ayuda">@grupo.Miembros.Count personas · @grupo.ConFormulario completaron el formulario</p>
                </div>

                @if (grupo.Curso == null)
                {
                    @if (grupo.ConFormulario > 0 && ViewBag.PuedeGenerar)
                    {
                        <form method="post" action='@Url.Action("Generar", "Curso")' onsubmit="mostrarCarga()">
                            <input type="hidden" name="IdRango" value="@grupo.Rango.IdRango" />
                            <!-- Para quién es el curso: solo el equipo, o también público en el buscador -->
                            <div class="campo">
                                <div><input type="radio" name="Publico" value="false" checked onchange="mostrarPublico(@grupo.Rango.IdRango, false)" /> Solo mi equipo</div>
                                <div><input type="radio" name="Publico" value="true" onchange="mostrarPublico(@grupo.Rango.IdRango, true)" /> Público 🌎</div>
                            </div>
                            <div class="campo oculto" id="publico-@grupo.Rango.IdRango">
                                <p class="ayuda">Un curso público aparece en el buscador para todas las empresas. La IA lo arma solo con el tema: no usa datos de tu empresa ni de tu equipo.</p>
                                <p class="pregunta">¿De qué trata?</p>
                                <input type="text" id="Tema-@grupo.Rango.IdRango" name="Tema" maxlength="300" placeholder="Ej.: automatizar tareas cotidianas con IA" />
                                <p class="pregunta">Categoría</p>
                                <select id="Categoria-@grupo.Rango.IdRango" name="Categoria">
                                    @foreach (string categoria in ViewBag.Categorias)
                                    {
                                        <option value="@categoria">@categoria</option>
                                    }
                                </select>
                            </div>
                            <input class="boton" type="submit" value="Generar curso del rango" />
                        </form>
                    }
                    else
                    {
                        <p class="etiqueta">Esperando que se sumen</p>
                    }
                }
                else
                {
                    <div class="botones">
                        <p class="etiqueta @(grupo.Curso.Estado == "Confirmado" ? "etiqueta-verde" : "etiqueta-naranja")">@(grupo.Curso.Estado == "Confirmado" ? "✓ Confirmado" : "Borrador")</p>
                        @if (grupo.Curso.Publico)
                        {
                            <p class="etiqueta etiqueta-azul">🌎 Público</p>
                        }
                        <a class="boton" href='@Url.Action("Ver", "Curso", new { IdCurso = grupo.Curso.IdCurso })'>@(grupo.Curso.Estado == "Confirmado" ? "Ver curso" : "Revisar curso")</a>
                    </div>
                }
            </div>

            @if (grupo.Curso != null)
            {
                <h3>📚 @grupo.Curso.Titulo</h3>
            }

            @if (grupo.Miembros.Count > 0)
            {
                @foreach (EmpleadoCurso miembro in grupo.Miembros)
                {
                    <div class="renglon">
                        <div>
                            <p class="negrita">@miembro.Nombre @miembro.Apellido</p>
                            <p class="ayuda">@miembro.Puesto</p>
                        </div>
                        @if (!miembro.TieneFormulario)
                        {
                            <p class="etiqueta">Sin formulario</p>
                        }
                        else if (miembro.SinAsignar)
                        {
                            <form method="post" action='@Url.Action("Sumar", "Curso")' onsubmit="mostrarCarga()">
                                <input type="hidden" name="IdCurso" value="@grupo.Curso.IdCurso" />
                                <input type="hidden" name="IdUsuario" value="@miembro.IdUsuario" />
                                <input class="boton" type="submit" value="Sumarlo al curso" />
                            </form>
                        }
                        else if (miembro.IdCurso > 0)
                        {
                            <p class="etiqueta">@miembro.Progreso% · ⚡ @miembro.XP XP</p>
                            @if (miembro.TextoActividad != "")
                            {
                                <p class="etiqueta etiqueta-naranja">⏸ @miembro.TextoActividad</p>
                            }
                        }
                    </div>
                }
            }
            else
            {
                <p class="ayuda">Todavía no hay nadie en este rango. Compartí su link desde <a href='@Url.Action("Index", "Equipo")'>Equipo</a>.</p>
            }
        </section>
    }
</main>

@section Scripts {
    <script src="~/js/curso.js" asp-append-version="true"></script>
}
