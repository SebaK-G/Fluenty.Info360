@using Fluenty.Info360.Models
@{
    ViewData["Title"] = ViewBag.Curso.Titulo;
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.EsDueno || ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Equipo")'>Equipo</a>
        }
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")' class='@(ViewBag.BotonActivo == "Cursos" ? "activo" : "")'>Cursos</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })' class='@(ViewBag.BotonActivo == "MiCurso" ? "activo" : "")'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos' class='@(ViewBag.BotonActivo == "MiCurso" ? "activo" : "")'>Mis cursos</a>
        }
        <a href='@Url.Action("Buscar", "CursoPublico")'>Explorar</a>
        <a href='@Url.Action("Index", "Asistente")'>Asistente</a>
        <a href='@Url.Action("Salir", "Home")' class="salir">Salir</a>
    </nav>
</header>

<!-- Pantalla de carga: mientras la IA rehace una unidad o arma una lección -->
<div id="carga" class="fondo-carga">
    <div class="tarjeta">
        <h2>@(ViewBag.ModoAlumno ? "Preparando tu lección" : "Rehaciendo la unidad")</h2>
        <div class="barra barra-carga"><div></div></div>
        <p>@(ViewBag.ModoAlumno ? "La IA está armando las explicaciones con ejemplos de tu trabajo." : "La IA está armando de nuevo esta unidad. El resto del curso queda igual.")</p>
    </div>
</div>

<main class="pagina">

    @if (ViewBag.Error != "")
    {
        <p class="aviso">@ViewBag.Error</p>
    }

    <!-- ===== Portada del curso ===== -->
    <section class="tarjeta">
        <p class="subtitulo">@ViewBag.Subtitulo</p>
        <h1>@ViewBag.Curso.Titulo</h1>
        <p>@ViewBag.Curso.Descripcion</p>

        <div class="grilla-3 separado">
            @if (ViewBag.ModoAlumno)
            {
                <div class="dato"><h3>⚡ @ViewBag.XP</h3><p>XP</p></div>
                <div class="dato"><h3>🔥 @ViewBag.Racha</h3><p>días de racha</p></div>
                <div class="dato"><h3>@ViewBag.Asignacion.Progreso%</h3><p>completado</p></div>
            }
            else
            {
                <div class="dato"><h3>4</h3><p>unidades</p></div>
                <div class="dato"><h3>20</h3><p>lecciones</p></div>
                <div class="dato"><h3>@ViewBag.Personas.Count</h3><p>personas</p></div>
            }
        </div>

        <h3 class="separado">Lo que vas a lograr</h3>
        <p>@ViewBag.Curso.Objetivos</p>
    </section>

    <!-- ===== Responsable: de quién se mira el camino ===== -->
    @if (!ViewBag.ModoAlumno)
    {
        <section class="tarjeta">
            <h2>El camino de cada persona</h2>
            <p class="ayuda">El curso es el mismo para todo el rango; cada uno arranca donde le corresponde.</p>
            <div class="separado">
                @foreach (Usuarios persona in ViewBag.Personas)
                {
                    <a class="boton-chico @(persona.Elegida ? "boton-chico-activo" : "")" href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Curso.IdCurso, IdUsuario = persona.IdUsuario })'>@persona.Nombre @persona.Apellido</a>
                }
            </div>
        </section>
    }

    @if (ViewBag.Asignacion != null)
    {
        <section class="tarjeta tarjeta-azul">
            <p>🎯 @ViewBag.TextoArranque</p>
            <p>@ViewBag.Asignacion.MotivoNivel</p>
        </section>
    }

    <!-- ===== El camino: unidades y lecciones ===== -->
    @foreach (Unidades unidad in ViewBag.Unidades)
    {
        <!-- unidad.Clase es color-1, color-2... o color-sabida si ya la sabe -->
        <section class="encabezado-unidad @unidad.Clase" id="unidad-@unidad.Numero">
            @if (unidad.Etiqueta != "")
            {
                <p class="etiqueta">@unidad.Etiqueta</p>
            }
            <p class="ayuda">UNIDAD @unidad.Numero</p>
            <h2>@unidad.Titulo</h2>
            <p>@unidad.Objetivo</p>
        </section>

        <section class="tarjeta">
            <div class="camino">
                @foreach (Lecciones leccion in unidad.Lecciones)
                {
                    <div class="paso paso-@leccion.Numero">
                        @if (leccion.SePuedeHacer)
                        {
                            <a class="circulo circulo-@leccion.Estado" href='@Url.Action("Index", "Leccion", new { IdLeccion = leccion.IdLeccion })' onclick="mostrarCarga()">@leccion.Icono</a>
                        }
                        else
                        {
                            <div class="circulo circulo-@leccion.Estado">@leccion.Icono</div>
                        }
                        <div>
                            <h3>@leccion.Titulo</h3>
                            <p class="ayuda">@leccion.Objetivo</p>
                            @if (leccion.Intentos > 0)
                            {
                                <!-- Nota = preguntas bien a la primera; intentos = cuántas veces la terminó (o rindió) -->
                                <p class="etiqueta @(leccion.Numero == 5 && leccion.Estado != "Completada" ? "etiqueta-naranja" : "etiqueta-verde")">Nota @leccion.Nota% · @leccion.Intentos @(leccion.Intentos == 1 ? "intento" : "intentos")</p>
                            }
                            @if (leccion.SePuedeHacer && leccion.Estado == "Disponible")
                            {
                                <a class="empezar" href='@Url.Action("Index", "Leccion", new { IdLeccion = leccion.IdLeccion })' onclick="mostrarCarga()">Empezar lección →</a>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (!ViewBag.ModoAlumno && ViewBag.Curso.Estado == "Borrador")
            {
                <!-- Rehacer solo esta unidad con un pedido para la IA -->
                <form class="campo caja separado" method="post" action='@Url.Action("RehacerUnidad", "Curso")' onsubmit="mostrarCarga()">
                    <input type="hidden" name="IdCurso" value="@ViewBag.Curso.IdCurso" />
                    <input type="hidden" name="NumeroUnidad" value="@unidad.Numero" />
                    <p class="pregunta">¿Querés cambiar la unidad @unidad.Numero? Contale a la IA qué cambiar:</p>
                    <div class="input-boton">
                        <input type="text" id="Pedido-@unidad.Numero" name="Pedido" maxlength="300" required placeholder="Ej.: que sea más difícil, con más ejemplos de Excel" />
                        <input class="boton" type="submit" value="Rehacer unidad @unidad.Numero" />
                    </div>
                </form>
            }
        </section>
    }

    <section class="tarjeta centrado">
        @if (!ViewBag.ModoAlumno && ViewBag.Curso.Estado == "Borrador")
        {
            <p class="aviso">Este curso es un borrador: el rango todavía no lo ve. Revisalo y confirmalo para que les llegue a todos.</p>
            <div class="botones centrado">
                <form method="post" action='@Url.Action("Descartar", "Curso")'>
                    <input type="hidden" name="IdCurso" value="@ViewBag.Curso.IdCurso" />
                    <input class="boton boton-rojo" type="submit" value="Descartar y volver a generar" />
                </form>
                <form method="post" action='@Url.Action("Confirmar", "Curso")'>
                    <input type="hidden" name="IdCurso" value="@ViewBag.Curso.IdCurso" />
                    <input class="boton" type="submit" value="Confirmar curso" />
                </form>
            </div>
        }
        else if (!ViewBag.ModoAlumno)
        {
            <a class="boton" href='@Url.Action("Index", "Curso")'>Volver a cursos</a>
        }
        else
        {
            <a class="boton" href='@Url.Action("Index", "Home")'>Volver al inicio</a>
        }
    </section>
</main>
