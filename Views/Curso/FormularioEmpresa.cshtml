@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Crea tu curso con IA";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")' class="activo">Cursos</a>
            <a href='@Url.Action("Index", "Calculadora")'>Calculadora</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
    </nav>
    <div class="usuario">
        <p>👤 @ViewBag.Menu.Nombre</p>
        <a class="salir" href='@Url.Action("Salir", "Home")'>Salir</a>
    </div>
</header>

<main class="pagina pagina-angosta">

    <section class="titulo-pagina">
        <h1>Contanos sobre tu equipo</h1>
        <p>La IA va a usar estas respuestas en todos los cursos que genere para tu empresa. Lo completás una sola vez.</p>
    </section>

    @if (ViewBag.Error != "")
    {
        <p class="aviso">@ViewBag.Error</p>
    }

    <form class="columna" method="post" action='@Url.Action("FormularioEmpresa", "Curso")'>

        <!-- ===== Presentación (se ve primero, salvo que haya un error) ===== -->
        <section class="tarjeta paso-formulario centrado @(ViewBag.Error != "" ? "oculto" : "")" id="paso-0">
            <h1>Creá tu curso con IA</h1>
            <h3 class="separado">Generá cursos de IA para capacitar a tus empleados</h3>
            <img class="logo-presentacion" src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
            <p>Rellená el formulario, sumá a tus empleados con el link de su rango y revisá los resultados para crear un curso personalizado y enfocado para cada uno.</p>
            <div class="botones centrado separado">
                <button type="button" class="boton boton-redondo" onclick="irAPaso(1)">Iniciar creación de cursos</button>
            </div>
        </section>

        <!-- ===== Pregunta 1 ===== -->
        <section class="tarjeta paso-formulario @(ViewBag.Error != "" ? "" : "oculto")" id="paso-1">
            <div class="encabezado-paso">
                <p class="numero-paso">1</p>
                <div>
                    <p class="paso-de">Preguntas 1 de 3</p>
                    <h2>Las dificultades de tu equipo</h2>
                </div>
            </div>
            <div class="campo">
                <p class="pregunta">¿Cuáles son los principales problemas o dificultades que enfrenta tu equipo en el trabajo diario? ¿Qué tareas o procesos te gustaría mejorar?</p>
                <input type="text" id="Dificultades" name="Dificultades" maxlength="500" required placeholder="Ej.: tardamos mucho en responder mails y armar reportes" />
            </div>

            <!-- Abajo: el botón en el medio y los números de página a la derecha -->
            <div class="pie-paso">
                <div></div>
                <div class="centrado"><button type="button" class="boton boton-redondo" onclick="irAPaso(2)">Siguiente</button></div>
                <div class="paginador">
                    <button type="button" class="flecha-pagina" onclick="irAPaso(1)">‹</button>
                    <button type="button" class="numero-pagina numero-pagina-activo" onclick="irAPaso(1)">1</button>
                    <button type="button" class="numero-pagina" onclick="irAPaso(2)">2</button>
                    <button type="button" class="numero-pagina" onclick="irAPaso(3)">3</button>
                    <button type="button" class="flecha-pagina" onclick="irAPaso(2)">›</button>
                </div>
            </div>
        </section>

        <!-- ===== Pregunta 2 ===== -->
        <section class="tarjeta paso-formulario oculto" id="paso-2">
            <div class="encabezado-paso">
                <p class="numero-paso">2</p>
                <div>
                    <p class="paso-de">Preguntas 2 de 3</p>
                    <h2>Las herramientas que usan</h2>
                </div>
            </div>
            <div class="campo">
                <p class="pregunta">¿Qué herramientas digitales utiliza actualmente tu equipo? ¿Utilizan herramientas de inteligencia artificial? (podés elegir varias)</p>
                <div>
                    @foreach (Herramientas herramienta in ViewBag.Herramientas)
                    {
                        <div class="boton-chico eleccion"><input onchange="pintarElecciones()" type="checkbox" name="Herramientas" value="@herramienta.IdHerramienta" /> @herramienta.Nombre</div>
                    }
                </div>
            </div>

            <!-- Abajo: el botón en el medio y los números de página a la derecha -->
            <div class="pie-paso">
                <div></div>
                <div class="centrado"><button type="button" class="boton boton-redondo" onclick="irAPaso(3)">Siguiente</button></div>
                <div class="paginador">
                    <button type="button" class="flecha-pagina" onclick="irAPaso(1)">‹</button>
                    <button type="button" class="numero-pagina" onclick="irAPaso(1)">1</button>
                    <button type="button" class="numero-pagina numero-pagina-activo" onclick="irAPaso(2)">2</button>
                    <button type="button" class="numero-pagina" onclick="irAPaso(3)">3</button>
                    <button type="button" class="flecha-pagina" onclick="irAPaso(3)">›</button>
                </div>
            </div>
        </section>

        <!-- ===== Pregunta 3 ===== -->
        <section class="tarjeta paso-formulario oculto" id="paso-3">
            <div class="encabezado-paso">
                <p class="numero-paso">3</p>
                <div>
                    <p class="paso-de">Preguntas 3 de 3</p>
                    <h2>Lo que querés lograr</h2>
                </div>
            </div>
            <div class="campo">
                <p class="pregunta">¿Qué te gustaría lograr mediante la capacitación de tus empleados? ¿Qué mejoras esperás conseguir en la productividad o en la forma de trabajar?</p>
                <input type="text" id="Objetivos" name="Objetivos" maxlength="500" required placeholder="Ej.: ahorrar horas en tareas repetitivas y cometer menos errores" />
            </div>

            <!-- Abajo: el botón en el medio y los números de página a la derecha -->
            <div class="pie-paso">
                <div></div>
                <div class="centrado"><input class="boton boton-redondo" type="submit" value="Enviar datos" onclick="revisarPasos()" /></div>
                <div class="paginador">
                    <button type="button" class="flecha-pagina" onclick="irAPaso(2)">‹</button>
                    <button type="button" class="numero-pagina" onclick="irAPaso(1)">1</button>
                    <button type="button" class="numero-pagina" onclick="irAPaso(2)">2</button>
                    <button type="button" class="numero-pagina numero-pagina-activo" onclick="irAPaso(3)">3</button>
                    <button type="button" class="flecha-pagina" onclick="irAPaso(3)">›</button>
                </div>
            </div>
        </section>

    </form>
</main>
