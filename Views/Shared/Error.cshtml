@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
</header>

<main class="pagina pagina-angosta">
    <section class="tarjeta centrado">
        <div class="medalla medalla-error">!</div>
        <h1>Algo salió mal</h1>
        <p>No pudimos procesar lo que pediste. Probá de nuevo en un rato.</p>
        @if (Model.ShowRequestId())
        {
            <p class="ayuda">Código del error: @Model.RequestId</p>
        }
        <div class="botones centrado">
            <a class="boton" href="/">Volver al inicio</a>
        </div>
    </section>
</main>
