@{
    ViewData["Title"] = "Prueba Groq";
}

<link rel="stylesheet" href="~/css/mensajes.css" asp-append-version="true" />

<div class="mensaje">
    <h1>Prueba de Groq</h1>

    <form action='@Url.Action("Index", "IA")' method="post">
        <label for="pregunta">Escribí una pregunta:</label>
        <textarea id="pregunta" name="pregunta" rows="4"></textarea>
        <div>
            <input class="boton" type="submit" value="Enviar" />
        </div>
    </form>

    @if (ViewBag.Respuesta != null)
    {
        <h3>Respuesta</h3>
        <p class="respuesta">@ViewBag.Respuesta</p>
    }
</div>
