@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Asistente";
}

<!-- Encabezado: el mismo en todas las pantallas -->
<header class="encabezado">
    <a class="logo" href="/">
        <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
        Fluenty
    </a>
    <nav class="menu">
        <a href='@Url.Action("Index", "Home")'>Home</a>
        @if (ViewBag.Menu.EsDueno || ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Equipo")'>Equipo</a>
        }
        @if (ViewBag.Menu.Gestiona)
        {
            <a href='@Url.Action("Index", "Curso")'>Cursos</a>
            <a href='@Url.Action("Index", "Empleados")'>Empleados</a>
        }
        @if (ViewBag.Menu.CantidadCursos == 1)
        {
            <a href='@Url.Action("Ver", "Curso", new { IdCurso = ViewBag.Menu.IdCursoPropio })'>Mi curso</a>
        }
        else if (ViewBag.Menu.CantidadCursos > 1)
        {
            <a href='@Url.Action("Index", "Home")#mis-cursos'>Mis cursos</a>
        }
        <a href='@Url.Action("Buscar", "CursoPublico")'>Explorar</a>
        <a href='@Url.Action("Index", "Asistente")' class="activo">Asistente</a>
        <a href='@Url.Action("Salir", "Home")' class="salir">Salir</a>
    </nav>
</header>

<main class="pagina">

    <section class="titulo-pagina">
        <p class="subtitulo">✦ Asistente de IA</p>
        <h1>Preguntale a la IA</h1>
        <p>Conoce tus tareas y tus cursos, así que te responde con ejemplos de tu trabajo.</p>
    </section>

    <div class="asistente">

        <!-- ===== Izquierda: los chats de la persona ===== -->
        <section class="tarjeta">
            <a class="boton boton-grande" href='@Url.Action("Index", "Asistente", new { IdChat = 0 })'>+ Nuevo chat</a>
            @if (ViewBag.Chats.Count == 0)
            {
                <p class="ayuda separado" id="sin-chats">Tus conversaciones van a aparecer acá.</p>
            }
            <!-- asistente.js agrega acá arriba el chat nuevo cuando se manda la primera pregunta -->
            <div id="lista-chats">
                @foreach (Chats item in ViewBag.Chats)
                {
                    <a class="item-chat @(item.IdChat == ViewBag.IdChat ? "item-chat-activo" : "")" href='@Url.Action("Index", "Asistente", new { IdChat = item.IdChat })'>
                        <p class="negrita">@item.Titulo</p>
                        <p class="ayuda">@item.FechaUltimo.ToString("dd/MM HH:mm")</p>
                    </a>
                }
            </div>
        </section>

        <!-- ===== Derecha: el chat abierto ===== -->
        <section class="tarjeta">
            <div class="fila">
                <h2 id="titulo-chat">@(ViewBag.Chat == null ? "Nuevo chat" : ViewBag.Chat.Titulo)</h2>
                <!-- En un chat nuevo no se ve: asistente.js lo muestra cuando se crea el chat -->
                <form method="post" action='@Url.Action("Borrar", "Asistente")' id="form-borrar" class="@(ViewBag.IdChat == 0 ? "oculto" : "")" onsubmit="return confirmarBorrado()">
                    <input type="hidden" name="IdChat" id="IdChatBorrar" value="@ViewBag.IdChat" />
                    <input class="boton boton-rojo" type="submit" value="Borrar chat" />
                </form>
            </div>

            <div class="mensajes" id="mensajes">
                <!-- Los mensajes del chat. asistente.js agrega acá abajo la pregunta y la respuesta nuevas -->
                <div id="historial">
                    @if (ViewBag.Mensajes.Count == 0)
                    {
                        <!-- Chat nuevo: saludo y preguntas para arrancar -->
                        <div class="centrado" id="bienvenida">
                            <h2>¡Hola, @ViewBag.Nombre! ¿En qué te ayudo?</h2>
                            <p>Preguntame cómo usar la IA en tu trabajo.</p>
                            <div class="separado">
                                @for (int i = 0; i < ViewBag.Sugerencias.Count; i++)
                                {
                                    <button type="button" class="boton-chico" id="sugerencia-@i" onclick="usarSugerencia(@i)">@ViewBag.Sugerencias[i]</button>
                                }
                            </div>
                        </div>
                    }

                    @foreach (MensajesChat mensaje in ViewBag.Mensajes)
                    {
                        if (mensaje.Rol == "IA")
                        {
                            <div class="mensaje mensaje-ia">
                                <div class="avatar-ia">✦</div>
                                <div class="burbuja">
                                    <!-- Cada renglón del mensaje es un párrafo (así se respetan los saltos de línea) -->
                                    @foreach (string parrafo in mensaje.Parrafos)
                                    {
                                        <p>@parrafo</p>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mensaje mensaje-mio">
                                <div class="burbuja">
                                    @foreach (string parrafo in mensaje.Parrafos)
                                    {
                                        <p>@parrafo</p>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Se muestran al mandar, mientras la IA responde -->
                <div class="mensaje mensaje-mio oculto" id="mi-pregunta">
                    <div class="burbuja"><p id="texto-mi-pregunta"></p></div>
                </div>
                <div class="mensaje mensaje-ia oculto" id="escribiendo">
                    <div class="avatar-ia">✦</div>
                    <div class="burbuja"><div class="puntitos"><div></div><div class="puntito-2"></div><div class="puntito-3"></div></div></div>
                </div>
            </div>

            <p class="error oculto" id="error-chat"></p>

            <!-- La pregunta se manda con fetch (asistente.js), sin recargar la página -->
            <div class="input-boton">
                <input type="hidden" id="IdChat" value="@ViewBag.IdChat" />
                <input type="text" id="texto" aria-label="Tu pregunta" maxlength="2000" placeholder="Escribí tu pregunta..." onkeydown="teclaEnter(event)" />
                <input class="boton" id="boton-enviar" type="button" value="Enviar" onclick="enviar()" />
            </div>
            <div class="en-linea ayuda separado">
                <p>Te quedan</p>
                <p id="restantes">@ViewBag.Restantes</p>
                <p>preguntas por hoy. La IA puede equivocarse: revisá lo importante.</p>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script src="~/js/asistente.js" asp-append-version="true"></script>
}
