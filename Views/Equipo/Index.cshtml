@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Equipo";
    ViewData["Activo"] = "Equipo";
}

<main class="pagina">

    <section class="titulo-pagina">
        <span class="subtitulo">Tu equipo</span>
        <h1>El árbol de tu empresa</h1>
        <p>Cada rango tiene su propio link: quien entra por ese link queda en ese rango. Cada rango ve y les crea cursos solo a los rangos que tiene abajo.</p>
    </section>

    <!-- ===== El árbol ===== -->
    <section class="tarjeta">
        <ul class="arbol">
            @foreach (Rangos rango in ViewBag.Arbol)
            {
                <!-- Van por niveles (primero el nivel 1, después el 2...). La clase nivel-N lo corre a la derecha y le da el color de su nivel -->
                <li class="caja rango nivel-@rango.NivelColor @(rango.EsPropio ? "rango-propio" : "")">
                    <div class="fila">
                        <div>
                            <h3>@rango.Nombre @(rango.EsPropio ? "(vos)" : "")</h3>
                            @if (rango.Profundidad == 0)
                            {
                                <span class="etiqueta">⬆ El de más arriba</span>
                            }
                            else
                            {
                                <span class="etiqueta">Nivel @rango.Profundidad · depende de <strong>@rango.NombrePadre</strong></span>
                            }
                            <p class="ayuda">@rango.CantidadPersonas personas</p>
                            @if (rango.IdRangoPadre > 0 && !ViewBag.EsDueno && rango.Tareas != "")
                            {
                                <p>@rango.Tareas</p>
                            }
                        </div>
                        @if (rango.IdRangoPadre > 0)
                        {
                            <div class="input-boton mitad">
                                <input type="text" value="@rango.Link" readonly />
                                <a class="boton" href="@rango.LinkWhatsApp">WhatsApp</a>
                            </div>
                        }
                    </div>
                    @if (rango.IdRangoPadre > 0 && ViewBag.EsDueno)
                    {
                        <!-- Qué hace la gente de este rango: si alguien llena mal su formulario, la IA usa esto.
                             El botón guarda con fetch (wwwroot/js/equipo.js), sin recargar la página. -->
                        <div class="campo separado">
                            <label for="Tareas-@rango.IdRango">¿Qué hace la gente de este rango?</label>
                            <div class="input-boton">
                                <input type="text" id="Tareas-@rango.IdRango" maxlength="300" value="@rango.Tareas" placeholder="Ej.: atienden clientes por WhatsApp, arman presupuestos y cargan las ventas" />
                                <input class="boton" type="button" value="Guardar" onclick="guardarTareas(@rango.IdRango)" />
                            </div>
                            <!-- Acá aparece "Guardado ✓" cuando se guarda -->
                            <p class="ayuda" id="Mensaje-@rango.IdRango">@(rango.Tareas == "" ? "⚠️ Completalo: si alguien de este rango llena mal su formulario, la IA arma el curso con esto." : "")</p>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>

    <!-- ===== Crear un rango (solo el dueño) ===== -->
    @if (ViewBag.EsDueno)
    {
        <section class="tarjeta">
            <h2>Agregar un rango</h2>
            <p class="ayuda">Por ejemplo: "Gerente" abajo de Dueño, y "Vendedor" abajo de Gerente.</p>
            @if (ViewBag.Error != "")
            {
                <p class="error">@ViewBag.Error</p>
            }
            <form class="grilla-4" method="post" action='@Url.Action("Crear", "Equipo")'>
                <div class="campo">
                    <label for="Nombre">Nombre del rango</label>
                    <input type="text" id="Nombre" name="Nombre" maxlength="50" required placeholder="Ej.: Vendedor" />
                </div>
                <div class="campo">
                    <label for="Tareas">¿Qué hace la gente?</label>
                    <input type="text" id="Tareas" name="Tareas" maxlength="300" placeholder="Ej.: atienden clientes y arman presupuestos" />
                </div>
                <div class="campo">
                    <label for="IdRangoPadre">Va abajo de</label>
                    <select id="IdRangoPadre" name="IdRangoPadre">
                        @foreach (Rangos rango in ViewBag.Arbol)
                        {
                            <option value="@rango.IdRango">@rango.Sangria @rango.Nombre</option>
                        }
                    </select>
                </div>
                <div class="campo">
                    <label>&nbsp;</label>
                    <input class="boton" type="submit" value="Agregar rango" />
                </div>
            </form>
        </section>
    }
</main>

@section Scripts {
    <script src="~/js/equipo.js" asp-append-version="true"></script>
}
