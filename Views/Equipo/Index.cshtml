@using Fluenty.Info360.Models
@{
    ViewData["Title"] = "Equipo";
}
@section Estilos {
    <link rel="stylesheet" href="~/css/curso.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sprint2.css" asp-append-version="true" />
}

<div class="pagina-curso">

    <header class="encabezado-app">
        <div class="logo-app">
            <img src="~/Imagenes/LogoAffinity.png" alt="Logo de Fluenty" />
            <span>Fluenty</span>
        </div>
        @await Html.PartialAsync("_NavApp", "Equipo")
    </header>

    <main class="contenido-curso">

        <section class="titulo-sprint2">
            <p class="etiqueta-sprint2">Tu equipo</p>
            <h1>El árbol de tu empresa</h1>
            <p>Cada rango tiene su propio link: quien entra por ese link queda en ese rango. Cada rango ve y les crea cursos solo a los rangos que tiene abajo.</p>
        </section>

        <!-- ===== El árbol ===== -->
        <section class="tarjeta-curso">
            <ul class="arbol">
                @foreach (Rangos rango in ViewBag.Arbol)
                {
                    <!-- Van por niveles (primero el nivel 1, después el 2...). La clase profundidad-N lo corre a la derecha y le da el color de su nivel -->
                    <li class="nodo profundidad-@rango.NivelColor">
                        <div class="caja-rango @(rango.EsPropio ? "caja-propia" : "")">
                            <div class="fila-rango">
                            <div class="datos-rango">
                                <p class="nombre-rango">@rango.Nombre @(rango.EsPropio ? "(vos)" : "")</p>
                                @if (rango.Profundidad == 0)
                                {
                                    <p class="jefe-rango">⬆ El de más arriba</p>
                                }
                                else
                                {
                                    <p class="jefe-rango">Nivel @rango.Profundidad · depende de <strong>@rango.NombrePadre</strong></p>
                                }
                                <p class="personas-rango">@rango.CantidadPersonas personas</p>
                                @if (rango.IdRangoPadre > 0 && !ViewBag.EsDueno && rango.Tareas != "")
                                {
                                    <p class="tareas-rango">@rango.Tareas</p>
                                }
                            </div>
                            @if (rango.IdRangoPadre > 0)
                            {
                                <div class="link-rango">
                                    <input type="text" value="@rango.Link" readonly />
                                    <a class="boton-curso" href="@rango.LinkWhatsApp">WhatsApp</a>
                                </div>
                            }
                            </div>
                            @if (rango.IdRangoPadre > 0 && ViewBag.EsDueno)
                            {
                                <!-- Qué hace la gente de este rango: si alguien llena mal su formulario, la IA usa esto.
                                     El botón guarda con fetch (wwwroot/js/equipo.js), sin recargar la página. -->
                                <div class="tareas-form">
                                    <label for="Tareas-@rango.IdRango">¿Qué hace la gente de este rango?</label>
                                    <div class="fila-tareas">
                                        <input type="text" id="Tareas-@rango.IdRango" maxlength="300" value="@rango.Tareas" placeholder="Ej.: atienden clientes por WhatsApp, arman presupuestos y cargan las ventas" />
                                        <input class="boton-curso" type="button" value="Guardar" onclick="guardarTareas(@rango.IdRango)" />
                                    </div>
                                    @if (rango.Tareas == "")
                                    {
                                        <p class="falta-tareas" id="Mensaje-@rango.IdRango">⚠️ Completalo: si alguien de este rango llena mal su formulario, la IA arma el curso con esto.</p>
                                    }
                                    else
                                    {
                                        <!-- Acá aparece "Guardado ✓" cuando se guarda -->
                                        <span class="falta-tareas" id="Mensaje-@rango.IdRango"></span>
                                    }
                                </div>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>

        <!-- ===== Crear un rango (solo el dueño) ===== -->
        @if (ViewBag.EsDueno)
        {
            <section class="tarjeta-curso">
                <h2>Agregar un rango</h2>
                <p class="ayuda-sprint2">Por ejemplo: "Gerente" abajo de Dueño, y "Vendedor" abajo de Gerente.</p>
                @if (ViewBag.Error != "")
                {
                    <p class="falta-tareas">@ViewBag.Error</p>
                }
                <form class="form-rango" method="post" action='@Url.Action("Crear", "Equipo")'>
                    <div class="campo-curso">
                        <label for="Nombre">Nombre del rango</label>
                        <input type="text" id="Nombre" name="Nombre" maxlength="50" required placeholder="Ej.: Vendedor" />
                    </div>
                    <div class="campo-curso">
                        <label for="Tareas">¿Qué hace la gente de este rango?</label>
                        <input type="text" id="Tareas" name="Tareas" maxlength="300" placeholder="Ej.: atienden clientes y arman presupuestos" />
                    </div>
                    <div class="campo-curso">
                        <label for="IdRangoPadre">Va abajo de</label>
                        <select id="IdRangoPadre" name="IdRangoPadre">
                            @foreach (Rangos rango in ViewBag.Arbol)
                            {
                                <option value="@rango.IdRango">@rango.Sangria @rango.Nombre</option>
                            }
                        </select>
                    </div>
                    <input class="boton-curso grande" type="submit" value="Agregar rango" />
                </form>
            </section>
        }
    </main>
</div>

@section Scripts {
    <script src="~/js/equipo.js" asp-append-version="true"></script>
}
